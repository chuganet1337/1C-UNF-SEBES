&НаКлиенте
Перем АдресПлана;
Перем КоличествоДокументовПлана;
Перем НачалоПлана;
Перем КонецПлана;
Перем ОшибокПлана;
Перем ИндексВозобновления;
Перем СостояниеПерепроведения;
Перем ЗапрошенаОстановка;
Перем ИсходноеКоличествоПроблем;

#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Этап = "создание реквизитов";
	Попытка
		СоздатьРеквизитыРабочегоМеста();
		Этап = "создание элементов формы";
		СоздатьИнтерфейсРабочегоМеста();
		Этап = "инициализация";
		УстановитьНачальныеЗначения();
	Исключение
		ВызватьИсключение "Аудит себестоимости 1.1.1. Этап: " + Этап
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ПостроениеИнтерфейса

&НаСервере
Процедура СоздатьРеквизитыРабочегоМеста()

	Реквизиты = Новый Массив;
	Реквизиты.Добавить(Новый РеквизитФормы("АС_ДатаНачала", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата))));
	Реквизиты.Добавить(Новый РеквизитФормы("АС_ДатаОкончания", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата))));
	Реквизиты.Добавить(Новый РеквизитФормы("АС_Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура")));
	Реквизиты.Добавить(Новый РеквизитФормы("АС_РезервнаяКопия", Новый ОписаниеТипов("Булево")));
	Реквизиты.Добавить(Новый РеквизитФормы("АС_Состояние", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(500))));
	Реквизиты.Добавить(Новый РеквизитФормы("АС_Журнал", Новый ОписаниеТипов("Строка")));
	ДобавитьРеквизитыПроблем(Реквизиты);
	ДобавитьРеквизитыПлана(Реквизиты, "АС_ПланМесяцы", Истина);
	ДобавитьРеквизитыПлана(Реквизиты, "АС_ПланВиды", Ложь);
	ИзменитьРеквизиты(Реквизиты);

	ЗначениеВРеквизитФормы(СоздатьТаблицуПроблем(), "АС_Проблемы");
	ЗначениеВРеквизитФормы(СоздатьТаблицуПланаМесяцев(), "АС_ПланМесяцы");
	ЗначениеВРеквизитФормы(СоздатьТаблицуПланаВидов(), "АС_ПланВиды");

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьРеквизитыПроблем(Реквизиты)

	Реквизиты.Добавить(Новый РеквизитФормы("АС_Проблемы", Новый ОписаниеТипов("ТаблицаЗначений")));
	Реквизиты.Добавить(Новый РеквизитФормы("Критичность", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20)), "АС_Проблемы"));
	Реквизиты.Добавить(Новый РеквизитФормы("Проверка", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)), "АС_Проблемы"));
	Реквизиты.Добавить(Новый РеквизитФормы("Дата", Новый ОписаниеТипов("Дата"), "АС_Проблемы"));
	Реквизиты.Добавить(Новый РеквизитФормы("Документ", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)), "АС_Проблемы"));
	Реквизиты.Добавить(Новый РеквизитФормы("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"), "АС_Проблемы"));
	Реквизиты.Добавить(Новый РеквизитФормы("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 6)), "АС_Проблемы"));
	Реквизиты.Добавить(Новый РеквизитФормы("Стоимость", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2)), "АС_Проблемы"));
	Реквизиты.Добавить(Новый РеквизитФормы("Причина", Новый ОписаниеТипов("Строка"), "АС_Проблемы"));

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьРеквизитыПлана(Реквизиты, ИмяТаблицы, ЭтоМесяцы)

	Реквизиты.Добавить(Новый РеквизитФормы(ИмяТаблицы, Новый ОписаниеТипов("ТаблицаЗначений")));
	Если ЭтоМесяцы Тогда
		Реквизиты.Добавить(Новый РеквизитФормы("Месяц", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)), ИмяТаблицы));
	Иначе
		Реквизиты.Добавить(Новый РеквизитФормы("ВидДокумента", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)), ИмяТаблицы));
	КонецЕсли;
	Реквизиты.Добавить(Новый РеквизитФормы("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)), ИмяТаблицы));

КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьТаблицуПроблем()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Критичность", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Проверка", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("Документ", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Таблица.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Стоимость", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Причина", Новый ОписаниеТипов("Строка"));
	Возврат Таблица;

КонецФункции

&НаСервереБезКонтекста
Функция СоздатьТаблицуПланаМесяцев()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Месяц", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Возврат Таблица;

КонецФункции

&НаСервереБезКонтекста
Функция СоздатьТаблицуПланаВидов()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ВидДокумента", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Возврат Таблица;

КонецФункции

&НаСервере
Процедура СоздатьИнтерфейсРабочегоМеста()

	ДобавитьКомандуФормы("АС_Аудит", "Выполнить аудит", "АС_Аудит");
	ДобавитьКомандуФормы("АС_Диагностика", "Проверка структуры", "АС_Диагностика");
	ДобавитьКомандуФормы("АС_СформироватьПлан", "Сформировать план", "АС_СформироватьПлан");
	ДобавитьКомандуФормы("АС_Перепровести", "Перепровести / продолжить", "АС_Перепровести");
	ДобавитьКомандуФормы("АС_Остановить", "Остановить после пакета", "АС_Остановить");
	ДобавитьКомандуФормы("АС_Контроль", "Контроль после исправления", "АС_Контроль");
	ДобавитьКомандуФормы("АС_ПоказатьЖурнал", "Журнал операции", "АС_ПоказатьЖурнал");

	Шапка = ДобавитьГруппу("АС_Шапка", , ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная);
	ДобавитьПоле("АС_ДатаНачалаПоле", "АС_ДатаНачала", "С", Шапка);
	ДобавитьПоле("АС_ДатаОкончанияПоле", "АС_ДатаОкончания", "По", Шапка);
	ДобавитьПоле("АС_НоменклатураПоле", "АС_Номенклатура", "Номенклатура (необязательно)", Шапка);
	ДобавитьКнопку("АС_КнопкаАудит", "АС_Аудит", Шапка);
	ДобавитьКнопку("АС_КнопкаДиагностика", "АС_Диагностика", Шапка);

	Предупреждение = ДобавитьПоле("АС_Предупреждение", "АС_Состояние", "Состояние и следующий шаг", Неопределено);
	Предупреждение.ТолькоПросмотр = Истина;

	РабочаяОбласть = ДобавитьГруппу("АС_РабочаяОбласть", , ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная);
	ЛеваяПанель = ДобавитьГруппу("АС_ЛеваяПанель", РабочаяОбласть, ГруппировкаПодчиненныхЭлементовФормы.Вертикальная, "Проблемы себестоимости");
	ПраваяПанель = ДобавитьГруппу("АС_ПраваяПанель", РабочаяОбласть, ГруппировкаПодчиненныхЭлементовФормы.Вертикальная, "План безопасного восстановления");
	ДобавитьТаблицуПроблем(ЛеваяПанель);
	ДобавитьТаблицуПлана("АС_ТаблицаПланаМесяцев", "АС_ПланМесяцы", "По месяцам", ПраваяПанель, Истина);
	ДобавитьТаблицуПлана("АС_ТаблицаПланаВидов", "АС_ПланВиды", "По видам документов", ПраваяПанель, Ложь);

	Подвал = ДобавитьГруппу("АС_Подвал", , ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная);
	ДобавитьКнопку("АС_КнопкаПлан", "АС_СформироватьПлан", Подвал);
	ДобавитьКнопку("АС_КнопкаПерепровести", "АС_Перепровести", Подвал);
	ДобавитьКнопку("АС_КнопкаОстановить", "АС_Остановить", Подвал);
	ДобавитьКнопку("АС_КнопкаКонтроль", "АС_Контроль", Подвал);
	ДобавитьКнопку("АС_КнопкаЖурнал", "АС_ПоказатьЖурнал", Подвал);
	ФлажокКопии = Элементы.Добавить("АС_РезервнаяКопияФлажок", Тип("ПолеФормы"), Подвал);
	ФлажокКопии.Вид = ВидПоляФормы.ПолеФлажка;
	ФлажокКопии.ПутьКДанным = "АС_РезервнаяКопия";
	ФлажокКопии.Заголовок = "Резервная копия создана и проверена";

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьКомандуФормы(ИмяКоманды, Заголовок, Действие)

	Команда = Команды.Добавить(ИмяКоманды);
	Команда.Заголовок = Заголовок;
	Команда.Действие = Действие;

КонецПроцедуры

&НаСервере
Функция ДобавитьГруппу(Имя, Родитель = Неопределено, Группировка = Неопределено, Заголовок = "")

	Если Родитель = Неопределено Тогда
		Группа = Элементы.Добавить(Имя, Тип("ГруппаФормы"));
	Иначе
		Группа = Элементы.Добавить(Имя, Тип("ГруппаФормы"), Родитель);
	КонецЕсли;
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Если Группировка <> Неопределено Тогда
		Группа.Группировка = Группировка;
	КонецЕсли;
	Если Не ПустаяСтрока(Заголовок) Тогда
		Группа.Заголовок = Заголовок;
	КонецЕсли;
	Возврат Группа;

КонецФункции

&НаСервере
Функция ДобавитьПоле(Имя, ПутьКДанным, Заголовок, Родитель = Неопределено)

	Если Родитель = Неопределено Тогда
		Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"));
	Иначе
		Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
	КонецЕсли;
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = ПутьКДанным;
	Поле.Заголовок = Заголовок;
	Возврат Поле;

КонецФункции

&НаСервере
Функция ДобавитьКнопку(Имя, ИмяКоманды, Родитель)

	Кнопка = Элементы.Добавить(Имя, Тип("КнопкаФормы"), Родитель);
	Кнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	Кнопка.ИмяКоманды = ИмяКоманды;
	Возврат Кнопка;

КонецФункции

&НаСервере
Процедура ДобавитьТаблицуПроблем(Родитель)

	Таблица = Элементы.Добавить("АС_ТаблицаПроблем", Тип("ТаблицаФормы"), Родитель);
	Таблица.ПутьКДанным = "АС_Проблемы";
	Таблица.ТолькоПросмотр = Истина;
	ДобавитьКолонкуТаблицы(Таблица, "АС_Проблемы", "Критичность", "Уровень");
	ДобавитьКолонкуТаблицы(Таблица, "АС_Проблемы", "Проверка", "Проверка");
	ДобавитьКолонкуТаблицы(Таблица, "АС_Проблемы", "Дата", "Дата");
	ДобавитьКолонкуТаблицы(Таблица, "АС_Проблемы", "Документ", "Документ");
	ДобавитьКолонкуТаблицы(Таблица, "АС_Проблемы", "Номенклатура", "Номенклатура");
	ДобавитьКолонкуТаблицы(Таблица, "АС_Проблемы", "Количество", "Количество");
	ДобавитьКолонкуТаблицы(Таблица, "АС_Проблемы", "Стоимость", "Стоимость");
	ДобавитьКолонкуТаблицы(Таблица, "АС_Проблемы", "Причина", "Пояснение");

КонецПроцедуры

&НаСервере
Процедура ДобавитьТаблицуПлана(ИмяЭлемента, ИмяРеквизита, Заголовок, Родитель, ЭтоМесяцы)

	Таблица = Элементы.Добавить(ИмяЭлемента, Тип("ТаблицаФормы"), Родитель);
	Таблица.ПутьКДанным = ИмяРеквизита;
	Таблица.Заголовок = Заголовок;
	Таблица.ТолькоПросмотр = Истина;
	Если ЭтоМесяцы Тогда
		ДобавитьКолонкуТаблицы(Таблица, ИмяРеквизита, "Месяц", "Месяц");
	Иначе
		ДобавитьКолонкуТаблицы(Таблица, ИмяРеквизита, "ВидДокумента", "Вид документа");
	КонецЕсли;
	ДобавитьКолонкуТаблицы(Таблица, ИмяРеквизита, "Количество", "Документов");

КонецПроцедуры

&НаСервере
Функция ДобавитьКолонкуТаблицы(Таблица, ИмяРеквизита, ИмяКолонки, Заголовок)

	Колонка = Элементы.Добавить(Таблица.Имя + ИмяКолонки, Тип("ПолеФормы"), Таблица);
	Колонка.Вид = ВидПоляФормы.ПолеВвода;
	Колонка.ПутьКДанным = ИмяРеквизита + "." + ИмяКолонки;
	Колонка.Заголовок = Заголовок;
	Колонка.ТолькоПросмотр = Истина;
	Возврат Колонка;

КонецФункции

&НаСервере
Процедура УстановитьНачальныеЗначения()

	ПредыдущийМесяц = ДобавитьМесяц(ТекущаяДатаСеанса(), -1);
	ЭтаФорма["АС_ДатаНачала"] = НачалоМесяца(ПредыдущийМесяц);
	ЭтаФорма["АС_ДатаОкончания"] = КонецМесяца(ПредыдущийМесяц);
	ЭтаФорма["АС_РезервнаяКопия"] = Ложь;
	ЭтаФорма["АС_Состояние"] = "1. Выполните аудит. 2. Сформируйте план. До запуска перепроведения данные не изменяются.";
	ЭтаФорма["АС_Журнал"] = "Аудит и восстановление себестоимости 1.1.1";

КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура АС_Диагностика(Команда)

	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(ПроверитьСтруктуруНаСервере());
	Документ.Показать("Проверка структуры УНФ для аудита себестоимости 1.1.1");

КонецПроцедуры

&НаКлиенте
Процедура АС_Аудит(Команда)

	Если Не ПроверитьПериодНаКлиенте() Тогда
		Возврат;
	КонецЕсли;

	Если СостояниеПерепроведения <> Неопределено Тогда
		Сообщить("Аудит нельзя запускать во время перепроведения.");
		Возврат;
	КонецЕсли;

	ЭтаФорма["АС_Состояние"] = "Выполняется детальный аудит. Данные не изменяются...";
	Попытка
		Результат = ВыполнитьАудитНаСервере();
	Исключение
		ЭтаФорма["АС_Состояние"] = "Аудит завершен с ошибкой.";
		ЭтаФорма["АС_Журнал"] = ЭтаФорма["АС_Журнал"] + Символы.ПС + Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Сообщить(ЭтаФорма["АС_Состояние"] + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ИсходноеКоличествоПроблем = Результат.КоличествоПроблем;
	ЭтаФорма["АС_Журнал"] = ЭтаФорма["АС_Журнал"] + Символы.ПС + Символы.ПС + Результат.Протокол;
	ЭтаФорма["АС_Состояние"] = СтрШаблон("Аудит завершен: %1 проблем, критичных - %2. Следующий шаг: сформировать план.",
		Результат.КоличествоПроблем, Результат.Критичных);

КонецПроцедуры

&НаКлиенте
Процедура АС_СформироватьПлан(Команда)

	Если Не ПроверитьПериодНаКлиенте() Тогда
		Возврат;
	КонецЕсли;

	Если СостояниеПерепроведения <> Неопределено Тогда
		Сообщить("Нельзя перестроить план во время перепроведения.");
		Возврат;
	КонецЕсли;

	АдресПлана = Неопределено;
	КоличествоДокументовПлана = 0;
	ОшибокПлана = 0;
	ИндексВозобновления = 0;
	ЭтаФорма["АС_Состояние"] = "Формируется план. Выполняется только чтение данных...";

	Попытка
		Результат = СформироватьПланНаСервере();
	Исключение
		ЭтаФорма["АС_Состояние"] = "План не сформирован.";
		ЭтаФорма["АС_Журнал"] = ЭтаФорма["АС_Журнал"] + Символы.ПС + Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Сообщить(ЭтаФорма["АС_Состояние"] + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	АдресПлана = Результат.АдресПлана;
	КоличествоДокументовПлана = Результат.Количество;
	НачалоПлана = Результат.Начало;
	КонецПлана = Результат.Конец;
	ОшибокПлана = Результат.Ошибок;
	ЭтаФорма["АС_Журнал"] = ЭтаФорма["АС_Журнал"] + Символы.ПС + Символы.ПС + Результат.Протокол;

	Если Результат.Количество = 0 Тогда
		ЭтаФорма["АС_Состояние"] = "В периоде нет проведенных документов.";
	ИначеЕсли Результат.Ошибок > 0 Тогда
		ЭтаФорма["АС_Состояние"] = "План содержит ошибки проверки. Запуск заблокирован; откройте журнал.";
	Иначе
		ЭтаФорма["АС_Состояние"] = СтрШаблон(
			"План готов: %1 документов. Подтвердите резервную копию и запускайте перепроведение.", Результат.Количество);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура АС_Перепровести(Команда)

	Если СостояниеПерепроведения <> Неопределено Тогда
		Сообщить("Перепроведение уже выполняется.");
		Возврат;
	КонецЕсли;

	Если Не ПроверитьГотовностьПланаНаКлиенте() Тогда
		Возврат;
	КонецЕсли;

	ТекстВопроса = "Будут неоперативно перепроведены ВСЕ проведенные документы периода в порядке МоментВремени."
		+ Символы.ПС + Символы.ПС
		+ "Период: " + Формат(НачалоПлана, "ДФ=dd.MM.yyyy") + " - " + Формат(КонецПлана, "ДФ=dd.MM.yyyy")
		+ Символы.ПС + "Документов: " + Строка(КоличествоДокументовПлана)
		+ Символы.ПС + "Начать с позиции: " + Строка(ИндексВозобновления + 1)
		+ Символы.ПС + Символы.ПС
		+ "Пользователи должны выйти из базы, обмены и фоновые задания должны быть остановлены."
		+ Символы.ПС + "После перепроведения требуется типовое закрытие месяцев от раннего к позднему."
		+ Символы.ПС + Символы.ПС + "Продолжить?";

	Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияПерепроведения", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияПерепроведения(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	СостояниеПерепроведения = Новый Структура;
	СостояниеПерепроведения.Вставить("Индекс", ИндексВозобновления);
	СостояниеПерепроведения.Вставить("Успешно", 0);
	СостояниеПерепроведения.Вставить("Пропущено", 0);
	СостояниеПерепроведения.Вставить("Ошибок", 0);
	СостояниеПерепроведения.Вставить("ДокументОшибки", "");
	СостояниеПерепроведения.Вставить("ТекстОшибки", "");
	ЗапрошенаОстановка = Ложь;

	ЗаписатьНачалоВЖурналНаСервере(НачалоПлана, КонецПлана, КоличествоДокументовПлана, ИндексВозобновления);
	ДобавитьВЖурналНаКлиенте(СтрШаблон("Запуск перепроведения с позиции %1 из %2.", ИндексВозобновления + 1, КоличествоДокументовПлана));
	ЭтаФорма["АС_Состояние"] = "Перепроведение запущено.";
	ОбработатьСледующийПакет();

КонецПроцедуры

&НаКлиенте
Процедура АС_Остановить(Команда)

	Если СостояниеПерепроведения = Неопределено Тогда
		Сообщить("Перепроведение сейчас не выполняется.");
		Возврат;
	КонецЕсли;

	ЗапрошенаОстановка = Истина;
	ЭтаФорма["АС_Состояние"] = "Запрошена остановка. Текущий пакет будет завершен.";

КонецПроцедуры

&НаКлиенте
Процедура АС_Контроль(Команда)

	Если Не ПроверитьПериодНаКлиенте() Тогда
		Возврат;
	КонецЕсли;

	Если СостояниеПерепроведения <> Неопределено Тогда
		Сообщить("Контроль нельзя запускать во время перепроведения.");
		Возврат;
	КонецЕсли;

	ЭтаФорма["АС_Состояние"] = "Выполняется контрольный аудит...";
	Попытка
		Результат = ВыполнитьАудитНаСервере();
	Исключение
		ЭтаФорма["АС_Состояние"] = "Контрольный аудит завершен с ошибкой.";
		Сообщить(ЭтаФорма["АС_Состояние"] + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Если ИсходноеКоличествоПроблем = Неопределено Тогда
		Сравнение = "Исходный аудит в этой форме не выполнялся.";
	Иначе
		Сравнение = СтрШаблон("Было проблем: %1; стало: %2; изменение: %3.",
			ИсходноеКоличествоПроблем, Результат.КоличествоПроблем,
			Результат.КоличествоПроблем - ИсходноеКоличествоПроблем);
	КонецЕсли;

	ЭтаФорма["АС_Журнал"] = ЭтаФорма["АС_Журнал"] + Символы.ПС + Символы.ПС + "КОНТРОЛЬ ПОСЛЕ ИСПРАВЛЕНИЯ"
		+ Символы.ПС + Сравнение + Символы.ПС + Результат.Протокол;
	ЭтаФорма["АС_Состояние"] = "Контроль завершен. " + Сравнение
		+ " Выполните типовое закрытие месяцев и повторите контроль.";

КонецПроцедуры

&НаКлиенте
Процедура АС_ПоказатьЖурнал(Команда)

	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(ЭтаФорма["АС_Журнал"]);
	Документ.Показать("Журнал аудита и восстановления себестоимости 1.1.1");

КонецПроцедуры

#КонецОбласти

#Область КлиентскоеПакетноеВыполнение

&НаКлиенте
Процедура ОбработатьСледующийПакет()

	Если СостояниеПерепроведения = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если СостояниеПерепроведения.Индекс >= КоличествоДокументовПлана Тогда
		ЗавершитьПерепроведение(Ложь, Ложь);
		Возврат;
	КонецЕсли;

	Попытка
		РезультатПакета = ПерепровестиПакетНаСервере(АдресПлана, СостояниеПерепроведения.Индекс, 10);
	Исключение
		СостояниеПерепроведения.Ошибок = СостояниеПерепроведения.Ошибок + 1;
		СостояниеПерепроведения.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗавершитьПерепроведение(Ложь, Истина);
		Возврат;
	КонецПопытки;

	СостояниеПерепроведения.Индекс = РезультатПакета.СледующийИндекс;
	ИндексВозобновления = РезультатПакета.СледующийИндекс;
	СостояниеПерепроведения.Успешно = СостояниеПерепроведения.Успешно + РезультатПакета.Успешно;
	СостояниеПерепроведения.Пропущено = СостояниеПерепроведения.Пропущено + РезультатПакета.Пропущено;
	СостояниеПерепроведения.Ошибок = СостояниеПерепроведения.Ошибок + РезультатПакета.Ошибок;
	Если Не ПустаяСтрока(РезультатПакета.Протокол) Тогда
		ДобавитьВЖурналНаКлиенте(РезультатПакета.Протокол);
	КонецЕсли;

	Если РезультатПакета.Ошибок > 0 Тогда
		СостояниеПерепроведения.ДокументОшибки = РезультатПакета.ДокументОшибки;
		СостояниеПерепроведения.ТекстОшибки = РезультатПакета.ТекстОшибки;
		ЗавершитьПерепроведение(Ложь, Истина);
		Возврат;
	КонецЕсли;

	ЭтаФорма["АС_Состояние"] = СтрШаблон("Обработано %1 из %2. Успешно: %3; пропущено: %4.",
		СостояниеПерепроведения.Индекс, КоличествоДокументовПлана,
		СостояниеПерепроведения.Успешно, СостояниеПерепроведения.Пропущено);

	Если ЗапрошенаОстановка Тогда
		ЗавершитьПерепроведение(Истина, Ложь);
		Возврат;
	КонецЕсли;

	Если СостояниеПерепроведения.Индекс >= КоличествоДокументовПлана Тогда
		ЗавершитьПерепроведение(Ложь, Ложь);
		Возврат;
	КонецЕсли;

	ПодключитьОбработчикОжидания("ПродолжитьПослеПаузы", 0.2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПослеПаузы() Экспорт

	ОбработатьСледующийПакет();

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПерепроведение(ОстановленоПользователем, ЗавершеноСОшибкой)

	Если СостояниеПерепроведения = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьЗавершениеВЖурналНаСервере(
		СостояниеПерепроведения.Успешно,
		СостояниеПерепроведения.Пропущено,
		СостояниеПерепроведения.Ошибок,
		СостояниеПерепроведения.ДокументОшибки,
		СостояниеПерепроведения.ТекстОшибки,
		ОстановленоПользователем,
		ИндексВозобновления);

	Итог = СтрШаблон("Перепроведение завершено. Успешно: %1; пропущено: %2; ошибок: %3.",
		СостояниеПерепроведения.Успешно, СостояниеПерепроведения.Пропущено, СостояниеПерепроведения.Ошибок);

	Если ОстановленоПользователем Тогда
		Итог = Итог + " Остановлено после пакета. Для продолжения нажмите 'Перепровести / продолжить'.";
	ИначеЕсли ЗавершеноСОшибкой Тогда
		Итог = Итог + " Ошибка: " + СостояниеПерепроведения.ДокументОшибки
			+ Символы.ПС + СостояниеПерепроведения.ТекстОшибки
			+ Символы.ПС + "После устранения причины сформируйте новый план либо продолжите с контрольной точки после проверки журнала.";
	Иначе
		ИндексВозобновления = 0;
		Итог = Итог + Символы.ПС
			+ "Следующий обязательный шаг: типовое закрытие месяцев от самого раннего к последнему, затем контрольный аудит.";
	КонецЕсли;

	ДобавитьВЖурналНаКлиенте(Итог);
	ЭтаФорма["АС_Состояние"] = Итог;
	СостояниеПерепроведения = Неопределено;
	ЗапрошенаОстановка = Ложь;
	Сообщить(Итог);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВЖурналНаКлиенте(Текст)

	ЭтаФорма["АС_Журнал"] = ЭтаФорма["АС_Журнал"] + Символы.ПС + Символы.ПС
		+ Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy HH:mm:ss") + Символы.ПС + Текст;

КонецПроцедуры

#КонецОбласти

#Область ПроверкиКлиента

&НаКлиенте
Функция ПроверитьПериодНаКлиенте()

	Если Не ЗначениеЗаполнено(ЭтаФорма["АС_ДатаНачала"]) Тогда
		Сообщить("Укажите начало периода.");
		Возврат Ложь;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЭтаФорма["АС_ДатаОкончания"]) Тогда
		Сообщить("Укажите конец периода.");
		Возврат Ложь;
	КонецЕсли;
	Если ЭтаФорма["АС_ДатаНачала"] > ЭтаФорма["АС_ДатаОкончания"] Тогда
		Сообщить("Начало периода больше окончания периода.");
		Возврат Ложь;
	КонецЕсли;
	Если КонецДня(ЭтаФорма["АС_ДатаОкончания"]) > КонецДня(ТекущаяДатаСеанса()) Тогда
		Сообщить("Конец периода не может быть позже текущей даты.");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;

КонецФункции

&НаКлиенте
Функция ПроверитьГотовностьПланаНаКлиенте()

	Если Не ПроверитьПериодНаКлиенте() Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(АдресПлана) Или КоличествоДокументовПлана = 0 Тогда
		Сообщить("Сначала сформируйте план перепроведения.");
		Возврат Ложь;
	КонецЕсли;
	Если ОшибокПлана > 0 Тогда
		Сообщить("План содержит ошибки проверки. Перепроведение заблокировано.");
		Возврат Ложь;
	КонецЕсли;
	Если НачалоДня(ЭтаФорма["АС_ДатаНачала"]) <> НачалоПлана
		Или КонецДня(ЭтаФорма["АС_ДатаОкончания"]) <> КонецПлана Тогда
		Сообщить("После формирования плана период был изменен. Сформируйте план повторно.");
		Возврат Ложь;
	КонецЕсли;
	Если Не ЭтаФорма["АС_РезервнаяКопия"] Тогда
		Сообщить("Подтвердите, что свежая резервная копия создана и проверена.");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;

КонецФункции

#КонецОбласти

#Область ДиагностикаСтруктуры

&НаСервереБезКонтекста
Функция ПроверитьСтруктуруНаСервере()

	Строки = Новый Массив;
	Строки.Добавить("АУДИТ СТРУКТУРЫ 1.1.1");
	Строки.Добавить("Конфигурация: " + Метаданные.Имя + " " + Метаданные.Версия);
	Строки.Добавить("Проверка содержит только имена объектов метаданных, без хозяйственных данных.");
	ДобавитьОписаниеРегистра(Строки, "Запасы", "Организация,СтруктурнаяЕдиница,Номенклатура,Характеристика,Партия,СчетУчета,ЗаказПокупателя,ЗаказНаПроизводство", "Количество,Сумма");
	ДобавитьОписаниеРегистра(Строки, "Продажи", "Номенклатура", "Количество,Себестоимость");
	Строки.Добавить("Документов в конфигурации: " + Строка(Метаданные.Документы.Количество()));
	Строки.Добавить("Важно: применимость расширения и штатное закрытие месяца проверяются в тестовой копии базы.");
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьОписаниеРегистра(Строки, ИмяРегистра, ИменаИзмерений, ИменаРесурсов)

	МетаРегистра = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
	Строки.Добавить("");
	Строки.Добавить("Регистр: " + ИмяРегистра);
	Если МетаРегистра = Неопределено Тогда
		Строки.Добавить("НЕ НАЙДЕН");
		Возврат;
	КонецЕсли;
	Строки.Добавить("Право чтения: " + Строка(ПравоДоступа("Чтение", МетаРегистра)));
	Для Каждого ИмяПоля Из СтрРазделить(ИменаИзмерений, ",") Цикл
		Строки.Добавить("Измерение " + ИмяПоля + ": " + ?(МетаРегистра.Измерения.Найти(ИмяПоля) = Неопределено, "НЕТ", "есть"));
	КонецЦикла;
	Для Каждого ИмяПоля Из СтрРазделить(ИменаРесурсов, ",") Цикл
		Строки.Добавить("Ресурс " + ИмяПоля + ": " + ?(МетаРегистра.Ресурсы.Найти(ИмяПоля) = Неопределено, "НЕТ", "есть"));
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьОбязательнуюСтруктуру()

	Ошибки = Новый Массив;
	МетаЗапасы = Метаданные.РегистрыНакопления.Найти("Запасы");
	Если МетаЗапасы = Неопределено Тогда
		Ошибки.Добавить("Не найден регистр накопления Запасы.");
	Иначе
		Если МетаЗапасы.Измерения.Найти("Номенклатура") = Неопределено Тогда
			Ошибки.Добавить("В регистре Запасы нет измерения Номенклатура.");
		КонецЕсли;
		Для Каждого ИмяПоля Из СтрРазделить("Количество,Сумма", ",") Цикл
			Если МетаЗапасы.Ресурсы.Найти(ИмяПоля) = Неопределено Тогда
				Ошибки.Добавить("В регистре Запасы нет ресурса " + ИмяПоля + ".");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Ошибки;

КонецФункции

#КонецОбласти

#Область СерверныйАудит

&НаСервере
Функция ВыполнитьАудитНаСервере()

	ОшибкиСтруктуры = ПроверитьОбязательнуюСтруктуру();
	Если ОшибкиСтруктуры.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(ОшибкиСтруктуры, Символы.ПС);
	КонецЕсли;

	НачалоПроверки = НачалоДня(ЭтаФорма["АС_ДатаНачала"]);
	КонецПроверки = КонецДня(ЭтаФорма["АС_ДатаОкончания"]);
	ФильтрНоменклатуры = ЭтаФорма["АС_Номенклатура"];
	Проблемы = СоздатьТаблицуПроблем();
	ТочностьКоличество = 0.000001;
	ТочностьСуммы = 0.01;

	ПроверитьОстаткиНаНачало(Проблемы, НачалоПроверки, ФильтрНоменклатуры, ТочностьКоличество, ТочностьСуммы);
	ПроверитьДвиженияЗапасов(Проблемы, НачалоПроверки, КонецПроверки, ФильтрНоменклатуры, ТочностьКоличество, ТочностьСуммы);
	ПроверитьПродажи(Проблемы, НачалоПроверки, КонецПроверки, ФильтрНоменклатуры, ТочностьКоличество, ТочностьСуммы);
	Проблемы.Сортировать("Дата Возр, Номенклатура Возр, Проверка Возр");
	ЗначениеВРеквизитФормы(Проблемы, "АС_Проблемы");

	Критичных = 0;
	Для Каждого СтрокаПроблемы Из Проблемы Цикл
		Если СтрокаПроблемы.Критичность = "КРИТИЧНО" Тогда
			Критичных = Критичных + 1;
		КонецЕсли;
	КонецЦикла;

	Протокол = "АУДИТ СЕБЕСТОИМОСТИ 1.1.1"
		+ Символы.ПС + "Конфигурация: " + Метаданные.Имя + " " + Метаданные.Версия
		+ Символы.ПС + "Период: " + Формат(НачалоПроверки, "ДФ=dd.MM.yyyy HH:mm:ss") + " - " + Формат(КонецПроверки, "ДФ=dd.MM.yyyy HH:mm:ss")
		+ Символы.ПС + "Фильтр номенклатуры: " + ?(ЗначениеЗаполнено(ФильтрНоменклатуры), Строка(ФильтрНоменклатуры), "вся номенклатура")
		+ Символы.ПС + "Найдено проблем: " + Строка(Проблемы.Количество()) + "; критичных: " + Строка(Критичных)
		+ Символы.ПС + "Повторные проблемы одной позиции не скрываются. Каждая строка требует предметной проверки.";

	ЗаписатьВЖурнал("АудитСебестоимости.Аудит", УровеньЖурналаРегистрации.Информация, , ,
		"Период: " + Формат(НачалоПроверки, "ДФ=dd.MM.yyyy") + " - " + Формат(КонецПроверки, "ДФ=dd.MM.yyyy")
		+ ". Проблем: " + Строка(Проблемы.Количество()) + ". Критичных: " + Строка(Критичных) + ".");

	Возврат Новый Структура("КоличествоПроблем,Критичных,Протокол", Проблемы.Количество(), Критичных, Протокол);

КонецФункции

&НаСервереБезКонтекста
Процедура ПроверитьОстаткиНаНачало(Проблемы, НачалоПериода, ФильтрНоменклатуры, ТочностьКоличество, ТочностьСуммы)

	ТекстЗапроса =
	"ВЫБРАТЬ
	|    Остатки.Номенклатура КАК Номенклатура,
	|    Остатки.КоличествоОстаток КАК Количество,
	|    Остатки.СуммаОстаток КАК Сумма
	|ИЗ
	|    РегистрНакопления.Запасы.Остатки(&НачалоПериода) КАК Остатки";
	Если ЗначениеЗаполнено(ФильтрНоменклатуры) Тогда
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "|ГДЕ Остатки.Номенклатура = &Номенклатура";
	КонецЕсли;

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Если ЗначениеЗаполнено(ФильтрНоменклатуры) Тогда
		Запрос.УстановитьПараметр("Номенклатура", ФильтрНоменклатуры);
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		ТипПроблемы = "";
		Критичность = "ПРОВЕРИТЬ";
		Если Выборка.Количество < -ТочностьКоличество Тогда
			ТипПроблемы = "Отрицательное количество на начало периода";
			Критичность = "КРИТИЧНО";
		ИначеЕсли Выборка.Количество > ТочностьКоличество И Выборка.Сумма < -ТочностьСуммы Тогда
			ТипПроблемы = "Отрицательная стоимость на начало периода";
			Критичность = "КРИТИЧНО";
		ИначеЕсли Выборка.Количество > ТочностьКоличество И Абс(Выборка.Сумма) <= ТочностьСуммы Тогда
			ТипПроблемы = "Количество без стоимости на начало периода";
		ИначеЕсли Абс(Выборка.Количество) <= ТочностьКоличество И Абс(Выборка.Сумма) > ТочностьСуммы Тогда
			ТипПроблемы = "Стоимость без количества на начало периода";
		КонецЕсли;
		Если Не ПустаяСтрока(ТипПроблемы) Тогда
			ДобавитьПроблему(Проблемы, Критичность, ТипПроблемы, НачалоПериода, Неопределено, Выборка.Номенклатура,
				Выборка.Количество, Выборка.Сумма, "Проблема существовала до выбранного периода; расширьте период назад.");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверитьДвиженияЗапасов(Проблемы, НачалоПериода, КонецПериода, ФильтрНоменклатуры, ТочностьКоличество, ТочностьСуммы)

	ТекстЗапроса =
	"ВЫБРАТЬ
	|    Данные.Период КАК Период,
	|    Данные.Регистратор КАК Регистратор,
	|    Данные.Номенклатура КАК Номенклатура,
	|    Данные.КоличествоНачальныйОстаток КАК КоличествоДо,
	|    Данные.СуммаНачальныйОстаток КАК СуммаДо,
	|    Данные.КоличествоОборот КАК КоличествоДвижение,
	|    Данные.СуммаОборот КАК СуммаДвижение,
	|    Данные.КоличествоКонечныйОстаток КАК КоличествоПосле,
	|    Данные.СуммаКонечныйОстаток КАК СуммаПосле
	|ИЗ
	|    РегистрНакопления.Запасы.ОстаткиИОбороты(
	|        &НачалоПериода,
	|        &КонецПериода,
	|        Регистратор,
	|        ДвиженияИГраницыПериода,
	|    ) КАК Данные";
	Если ЗначениеЗаполнено(ФильтрНоменклатуры) Тогда
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "|ГДЕ Данные.Номенклатура = &Номенклатура";
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + Символы.ПС + "|УПОРЯДОЧИТЬ ПО Данные.Период";

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Если ЗначениеЗаполнено(ФильтрНоменклатуры) Тогда
		Запрос.УстановитьПараметр("Номенклатура", ФильтрНоменклатуры);
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.Регистратор) Тогда
			Продолжить;
		КонецЕсли;
		ТипПроблемы = "";
		Критичность = "КРИТИЧНО";
		Если Выборка.КоличествоДо >= -ТочностьКоличество И Выборка.КоличествоПосле < -ТочностьКоличество Тогда
			ТипПроблемы = "Документ создал отрицательный остаток";
		ИначеЕсли Выборка.КоличествоПосле > ТочностьКоличество И Абс(Выборка.СуммаПосле) <= ТочностьСуммы
			И Не (Выборка.КоличествоДо > ТочностьКоличество И Абс(Выборка.СуммаДо) <= ТочностьСуммы) Тогда
			ТипПроблемы = "Документ создал количество без стоимости";
			Критичность = "ПРОВЕРИТЬ";
		ИначеЕсли Выборка.КоличествоПосле > ТочностьКоличество И Выборка.СуммаПосле < -ТочностьСуммы
			И Не (Выборка.КоличествоДо > ТочностьКоличество И Выборка.СуммаДо < -ТочностьСуммы) Тогда
			ТипПроблемы = "Документ создал отрицательную стоимость";
		ИначеЕсли Абс(Выборка.КоличествоПосле) <= ТочностьКоличество И Абс(Выборка.СуммаПосле) > ТочностьСуммы
			И Абс(Выборка.КоличествоДо) > ТочностьКоличество Тогда
			ТипПроблемы = "Документ оставил стоимость без количества";
			Критичность = "ПРОВЕРИТЬ";
		КонецЕсли;

		Если Не ПустаяСтрока(ТипПроблемы) Тогда
			Причина = СтрШаблон("До: %1 / %2; движение: %3 / %4; после: %5 / %6.",
				Выборка.КоличествоДо, Выборка.СуммаДо, Выборка.КоличествоДвижение, Выборка.СуммаДвижение,
				Выборка.КоличествоПосле, Выборка.СуммаПосле);
			ДобавитьПроблему(Проблемы, Критичность, ТипПроблемы, Выборка.Период, Выборка.Регистратор,
				Выборка.Номенклатура, Выборка.КоличествоПосле, Выборка.СуммаПосле, Причина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверитьПродажи(Проблемы, НачалоПериода, КонецПериода, ФильтрНоменклатуры, ТочностьКоличество, ТочностьСуммы)

	МетаПродажи = Метаданные.РегистрыНакопления.Найти("Продажи");
	Если МетаПродажи = Неопределено
		Или МетаПродажи.Измерения.Найти("Номенклатура") = Неопределено
		Или МетаПродажи.Ресурсы.Найти("Количество") = Неопределено
		Или МетаПродажи.Ресурсы.Найти("Себестоимость") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекстЗапроса =
	"ВЫБРАТЬ
	|    Продажи.Период КАК Период,
	|    Продажи.Регистратор КАК Регистратор,
	|    Продажи.Номенклатура КАК Номенклатура,
	|    Продажи.Количество КАК Количество,
	|    Продажи.Себестоимость КАК Себестоимость
	|ИЗ
	|    РегистрНакопления.Продажи КАК Продажи
	|ГДЕ
	|    Продажи.Период >= &НачалоПериода
	|    И Продажи.Период <= &КонецПериода";
	Если ЗначениеЗаполнено(ФильтрНоменклатуры) Тогда
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "|    И Продажи.Номенклатура = &Номенклатура";
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + Символы.ПС + "|УПОРЯДОЧИТЬ ПО Продажи.Период";

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Если ЗначениеЗаполнено(ФильтрНоменклатуры) Тогда
		Запрос.УстановитьПараметр("Номенклатура", ФильтрНоменклатуры);
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Если Выборка.Количество <= ТочностьКоличество Тогда
			Продолжить;
		КонецЕсли;
		Если Выборка.Себестоимость < -ТочностьСуммы Тогда
			ДобавитьПроблему(Проблемы, "КРИТИЧНО", "Продажа с отрицательной себестоимостью", Выборка.Период,
				Выборка.Регистратор, Выборка.Номенклатура, Выборка.Количество, Выборка.Себестоимость,
				"В регистре Продажи записана отрицательная себестоимость.");
		ИначеЕсли Абс(Выборка.Себестоимость) <= ТочностьСуммы Тогда
			ДобавитьПроблему(Проблемы, "ПРОВЕРИТЬ", "Продажа с нулевой себестоимостью", Выборка.Период,
				Выборка.Регистратор, Выборка.Номенклатура, Выборка.Количество, Выборка.Себестоимость,
				"Нулевая себестоимость допустима не во всех хозяйственных сценариях; требуется проверка.");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьПроблему(Проблемы, Критичность, Проверка, ДатаПроблемы, Регистратор,
	Номенклатура, Количество, Стоимость, Причина)

	СтрокаПроблемы = Проблемы.Добавить();
	СтрокаПроблемы.Критичность = Критичность;
	СтрокаПроблемы.Проверка = Проверка;
	СтрокаПроблемы.Дата = ДатаПроблемы;
	СтрокаПроблемы.Документ = ?(ЗначениеЗаполнено(Регистратор), Строка(Регистратор), "Проблема на начало периода");
	СтрокаПроблемы.Номенклатура = Номенклатура;
	СтрокаПроблемы.Количество = Количество;
	СтрокаПроблемы.Стоимость = Стоимость;
	СтрокаПроблемы.Причина = Причина;

КонецПроцедуры

#КонецОбласти

#Область СерверноеФормированиеПлана

&НаСервере
Функция СформироватьПланНаСервере()

	НачалоПериода = НачалоДня(ЭтаФорма["АС_ДатаНачала"]);
	КонецПериода = КонецДня(ЭтаФорма["АС_ДатаОкончания"]);
	ТаблицаПлана = Новый ТаблицаЗначений;
	ТаблицаПлана.Колонки.Добавить("Момент");
	ТаблицаПлана.Колонки.Добавить("Ссылка");
	ТаблицаПлана.Колонки.Добавить("ВидДокумента");
	ТаблицаПлана.Колонки.Добавить("Дата");
	СтатистикаМесяцев = Новый Соответствие;
	СтатистикаВидов = Новый Соответствие;
	Ошибки = Новый Массив;

	// BSLLS:CreateQueryInCycle-off
	// Текст таблицы документа зависит от текущего объекта метаданных и не может быть параметром одного запроса.
	Для Каждого МетаДокумента Из Метаданные.Документы Цикл
		Если Не ПравоДоступа("Чтение", МетаДокумента) Тогда
			Ошибки.Добавить(МетаДокумента.Имя + ": нет права чтения.");
			Продолжить;
		КонецЕсли;
		ТекстЗапроса =
		"ВЫБРАТЬ
		|    Документы.Ссылка КАК Ссылка,
		|    Документы.Дата КАК Дата
		|ИЗ
		|    Документ.%ИМЯДОКУМЕНТА% КАК Документы
		|ГДЕ
		|    Документы.Проведен = ИСТИНА
		|    И Документы.ПометкаУдаления = ЛОЖЬ
		|    И Документы.Дата >= &НачалоПериода
		|    И Документы.Дата <= &КонецПериода";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ИМЯДОКУМЕНТА%", МетаДокумента.Имя);
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

		Попытка
			Выборка = Запрос.Выполнить().Выбрать();
		Исключение
			Ошибки.Добавить(МетаДокумента.Имя + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Продолжить;
		КонецПопытки;

		КоличествоВида = 0;
		Пока Выборка.Следующий() Цикл
			СтрокаПлана = ТаблицаПлана.Добавить();
			СтрокаПлана.Ссылка = Выборка.Ссылка;
			СтрокаПлана.Дата = Выборка.Дата;
			СтрокаПлана.ВидДокумента = МетаДокумента.Имя;
			СтрокаПлана.Момент = Выборка.Ссылка.МоментВремени();
			УвеличитьСчетчик(СтатистикаМесяцев, НачалоМесяца(Выборка.Дата));
			УвеличитьСчетчик(СтатистикаВидов, МетаДокумента.Имя);
			КоличествоВида = КоличествоВида + 1;
		КонецЦикла;
		Если КоличествоВида > 0 И Не ПравоДоступа("Изменение", МетаДокумента) Тогда
			Ошибки.Добавить(МетаДокумента.Имя + ": в периоде есть документы, но нет права изменения.");
		КонецЕсли;
	КонецЦикла;
	// BSLLS:CreateQueryInCycle-on

	ТаблицаПлана.Сортировать("Момент Возр");
	План = Новый Массив;
	Для Каждого СтрокаПлана Из ТаблицаПлана Цикл
		План.Добавить(Новый Структура("Ссылка,ВидДокумента,Дата", СтрокаПлана.Ссылка, СтрокаПлана.ВидДокумента, СтрокаПлана.Дата));
	КонецЦикла;
	Адрес = ПоместитьВоВременноеХранилище(План, УникальныйИдентификатор);

	ТаблицаМесяцев = СоздатьТаблицуПланаМесяцев();
	Для Каждого Элемент Из СтатистикаМесяцев Цикл
		Строка = ТаблицаМесяцев.Добавить();
		Строка.Месяц = Элемент.Ключ;
		Строка.Количество = Элемент.Значение;
	КонецЦикла;
	ТаблицаМесяцев.Сортировать("Месяц Возр");

	ТаблицаВидов = СоздатьТаблицуПланаВидов();
	Для Каждого Элемент Из СтатистикаВидов Цикл
		Строка = ТаблицаВидов.Добавить();
		Строка.ВидДокумента = Элемент.Ключ;
		Строка.Количество = Элемент.Значение;
	КонецЦикла;
	ТаблицаВидов.Сортировать("Количество Убыв, ВидДокумента Возр");
	ЗначениеВРеквизитФормы(ТаблицаМесяцев, "АС_ПланМесяцы");
	ЗначениеВРеквизитФормы(ТаблицаВидов, "АС_ПланВиды");

	Протокол = "ПЛАН ВОССТАНОВЛЕНИЯ 1.1.1"
		+ Символы.ПС + "Период: " + Формат(НачалоПериода, "ДФ=dd.MM.yyyy HH:mm:ss") + " - " + Формат(КонецПериода, "ДФ=dd.MM.yyyy HH:mm:ss")
		+ Символы.ПС + "Все проведенные документы периода: " + Строка(План.Количество())
		+ Символы.ПС + "Порядок: МоментВремени; неоперативное проведение; пакет 10 документов."
		+ Символы.ПС + "Данные при формировании плана не изменялись.";
	Если Ошибки.Количество() > 0 Тогда
		Протокол = Протокол + Символы.ПС + Символы.ПС + "ОШИБКИ - ЗАПУСК ЗАБЛОКИРОВАН:"
			+ Символы.ПС + СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;

	ЗаписатьВЖурнал("АудитСебестоимости.План", УровеньЖурналаРегистрации.Информация, , ,
		"Документов: " + Строка(План.Количество()) + ". Ошибок: " + Строка(Ошибки.Количество()) + ".");
	Возврат Новый Структура("АдресПлана,Количество,Начало,Конец,Ошибок,Протокол",
		Адрес, План.Количество(), НачалоПериода, КонецПериода, Ошибки.Количество(), Протокол);

КонецФункции

&НаСервереБезКонтекста
Процедура УвеличитьСчетчик(СоответствиеСчетчиков, Ключ)

	ЗначениеСчетчика = СоответствиеСчетчиков.Получить(Ключ);
	Если ЗначениеСчетчика = Неопределено Тогда
		СоответствиеСчетчиков.Вставить(Ключ, 1);
	Иначе
		СоответствиеСчетчиков.Вставить(Ключ, ЗначениеСчетчика + 1);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СерверноеПерепроведение

&НаСервереБезКонтекста
Функция ПерепровестиПакетНаСервере(Знач АдресВременногоХранилища, Знач НачальныйИндекс, Знач РазмерПакета)

	План = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
	Если План = Неопределено Тогда
		ВызватьИсключение "План отсутствует во временном хранилище. Сформируйте его повторно.";
	КонецЕсли;

	СледующийИндекс = НачальныйИндекс;
	Успешно = 0;
	Пропущено = 0;
	Ошибок = 0;
	ДокументОшибки = "";
	ТекстОшибки = "";
	СтрокиПротокола = Новый Массив;
	КонечныйИндекс = Мин(План.Количество(), НачальныйИндекс + РазмерПакета);

	Для Индекс = НачальныйИндекс По КонечныйИндекс - 1 Цикл
		ОписаниеДокумента = План[Индекс];
		СсылкаДокумента = ОписаниеДокумента.Ссылка;
		Попытка
			ОбъектДокумента = СсылкаДокумента.ПолучитьОбъект();
			Если Не ОбъектДокумента.Проведен Тогда
				Пропущено = Пропущено + 1;
				СледующийИндекс = Индекс + 1;
				СтрокиПротокола.Добавить("ПРОПУЩЕН: " + Строка(СсылкаДокумента) + " - документ больше не проведен.");
				Продолжить;
			КонецЕсли;
			ОбъектДокумента.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
			Успешно = Успешно + 1;
			СледующийИндекс = Индекс + 1;
			СтрокиПротокола.Добавить("ОК: " + Строка(СсылкаДокумента));
			ЗаписатьВЖурнал("АудитСебестоимости.Документ.Перепроведен", УровеньЖурналаРегистрации.Информация,
				Метаданные.НайтиПоТипу(ТипЗнч(СсылкаДокумента)), СсылкаДокумента, ОписаниеДокумента.ВидДокумента);
		Исключение
			Ошибок = 1;
			ДокументОшибки = Строка(СсылкаДокумента);
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			СтрокиПротокола.Добавить("ОШИБКА: " + ДокументОшибки + Символы.ПС + ТекстОшибки);
			ЗаписатьВЖурнал("АудитСебестоимости.Документ.Ошибка", УровеньЖурналаРегистрации.Ошибка,
				Метаданные.НайтиПоТипу(ТипЗнч(СсылкаДокумента)), СсылкаДокумента, ТекстОшибки);
			Прервать;
		КонецПопытки;
	КонецЦикла;

	Возврат Новый Структура("СледующийИндекс,Успешно,Пропущено,Ошибок,ДокументОшибки,ТекстОшибки,Протокол",
		СледующийИндекс, Успешно, Пропущено, Ошибок, ДокументОшибки, ТекстОшибки, СтрСоединить(СтрокиПротокола, Символы.ПС));

КонецФункции

#КонецОбласти

#Область ЖурналРегистрации

&НаСервереБезКонтекста
Процедура ЗаписатьНачалоВЖурналНаСервере(Знач НачалоПериода, Знач КонецПериода,
	Знач КоличествоДокументов, Знач НачальныйИндекс)

	ЗаписатьВЖурнал("АудитСебестоимости.Начало", УровеньЖурналаРегистрации.Информация, , ,
		"Версия 1.1.1. Период: " + Формат(НачалоПериода, "ДФ=dd.MM.yyyy HH:mm:ss")
		+ " - " + Формат(КонецПериода, "ДФ=dd.MM.yyyy HH:mm:ss")
		+ ". Документов: " + Строка(КоличествоДокументов) + ". Индекс: " + Строка(НачальныйИндекс) + ".");

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьЗавершениеВЖурналНаСервере(Знач Успешно, Знач Пропущено, Знач Ошибок,
	Знач ДокументОшибки, Знач ТекстОшибки, Знач Остановлено, Знач Индекс)

	Уровень = ?(Ошибок > 0, УровеньЖурналаРегистрации.Ошибка, УровеньЖурналаРегистрации.Информация);
	Комментарий = "Версия 1.1.1. Успешно: " + Строка(Успешно)
		+ ". Пропущено: " + Строка(Пропущено) + ". Ошибок: " + Строка(Ошибок)
		+ ". Остановлено: " + Строка(Остановлено) + ". Следующий индекс: " + Строка(Индекс) + ".";
	Если Ошибок > 0 Тогда
		Комментарий = Комментарий + " Документ: " + ДокументОшибки + ". Ошибка: " + ТекстОшибки;
	КонецЕсли;
	ЗаписатьВЖурнал("АудитСебестоимости.Завершено", Уровень, , , Комментарий);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьВЖурнал(ИмяСобытия, Уровень, ОбъектМетаданных = Неопределено, Данные = Неопределено, Комментарий = "")

	Попытка
		ЗаписьЖурналаРегистрации(ИмяСобытия, Уровень, ОбъектМетаданных, Данные, Лев(Комментарий, 5000));
	Исключение
		// Ошибка журнала не должна останавливать учетную операцию.
		Возврат;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
