&НаКлиенте
Перем СостояниеПерепроведения; // состояние пакетного перепроведения между обработчиками ожидания

////////////////////////////////////////////////////////////////////////////////
//
// ЧАСТЬ 1. ПОИСК СЛОМАННОЙ СЕБЕСТОИМОСТИ
//
// Анализ всегда выполняется ТОЛЬКО по датам формы и сразу по всей
// номенклатуре. Номенклатуру для анализа выбирать не нужно.
//
////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура Проверить(Команда)

	Если Не ПроверитьПериодНаКлиенте() Тогда
		Возврат;
	КонецЕсли;

	Попытка

		ПроверитьНаСервере();

	Исключение

		ТекстОшибки = ОписаниеОшибки();
		ЗаписатьОшибкаВЖурналНаСервере(
			"Анализ себестоимости",
			Неопределено,
			ТекстОшибки);

		Сообщить(
			"Ошибка проверки себестоимости:"
			+ Символы.ПС
			+ ТекстОшибки);

		Возврат;

	КонецПопытки;

	Сообщить(
		"Проверка завершена."
		+ Символы.ПС
		+ "Период: "
		+ Формат(ДатаНачала, "ДФ=dd.MM.yyyy")
		+ " - "
		+ Формат(ДатаОкончания, "ДФ=dd.MM.yyyy")
		+ Символы.ПС
		+ "Найдено проблемных позиций: "
		+ Строка(Результат.Количество()));

КонецПроцедуры


&НаКлиенте
Функция ПроверитьПериодНаКлиенте()

	Если Не ЗначениеЗаполнено(ДатаНачала) Тогда
		Сообщить("Укажите дату начала.");
		Возврат Ложь;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		Сообщить("Укажите дату окончания.");
		Возврат Ложь;
	КонецЕсли;

	Если ДатаНачала > ДатаОкончания Тогда
		Сообщить("Дата начала больше даты окончания.");
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции


////////////////////////////////////////////////////////////////////////////////
//
// ЧАСТЬ 2. ИСПРАВЛЕНИЕ ОДНОЙ НОМЕНКЛАТУРЫ
//
// Кнопка "Перепровести документы" ОБЯЗАТЕЛЬНО просит выбрать конкретную
// номенклатуру. Даты формы при исправлении не используются.
//
// После выбора позиции обработка сама находит ее первое движение и собирает
// всю цепочку документов от первого движения до текущей даты.
//
// Важно: 1С перепроводит документ ЦЕЛИКОМ. Если в документе есть другие
// позиции, их движения тоже будут пересчитаны.
//
////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура Перепровести(Команда)

	Если СостояниеПерепроведения <> Неопределено Тогда
		Сообщить("Перепроведение уже выполняется. Дождитесь завершения текущей позиции.");
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения(
		"ПослеВыбораНоменклатурыДляПерепроведения",
		ЭтотОбъект);

	ТипНоменклатуры = Новый ОписаниеТипов(
		"СправочникСсылка.Номенклатура");

	НачальноеЗначение = Неопределено;

	ПоказатьВводЗначения(
		Оповещение,
		НачальноеЗначение,
		"Выберите ОДНУ номенклатуру для исправления себестоимости",
		ТипНоменклатуры);

КонецПроцедуры


&НаКлиенте
Процедура ПослеВыбораНоменклатурыДляПерепроведения(
	НоменклатураДляПерепроведения,
	ДополнительныеПараметры) Экспорт

	Если Не ЗначениеЗаполнено(НоменклатураДляПерепроведения) Тогда
		Сообщить("Исправление отменено: номенклатура не выбрана.");
		Возврат;
	КонецЕсли;

	Попытка

		Информация = ПолучитьИнформациюПерепроведенияНаСервере(
			НоменклатураДляПерепроведения);

	Исключение

		ТекстОшибки = ОписаниеОшибки();
		ЗаписатьОшибкаВЖурналНаСервере(
			"Формирование цепочки перепроведения",
			НоменклатураДляПерепроведения,
			ТекстОшибки);

		Сообщить(
			"Не удалось сформировать цепочку документов по позиции:"
			+ Символы.ПС
			+ ТекстОшибки);

		Возврат;

	КонецПопытки;

	Если Информация.Количество = 0 Тогда

		Сообщить(
			"По позиции "
			+ Строка(НоменклатураДляПерепроведения)
			+ " движения не найдены.");

		Возврат;

	КонецЕсли;

	ТекстВопроса =
		"ИСПРАВЛЕНИЕ СЕБЕСТОИМОСТИ"
		+ Символы.ПС
		+ Символы.ПС
		+ "Номенклатура: "
		+ Строка(НоменклатураДляПерепроведения)
		+ Символы.ПС
		+ "Первое найденное движение: "
		+ Формат(Информация.Начало, "ДФ=dd.MM.yyyy HH:mm:ss")
		+ Символы.ПС
		+ "Перепроведение до: "
		+ Формат(Информация.Конец, "ДФ=dd.MM.yyyy HH:mm:ss")
		+ Символы.ПС
		+ "Документов: "
		+ Строка(Информация.Количество)
		+ Символы.ПС
		+ Символы.ПС
		+ "Даты формы НЕ используются."
		+ Символы.ПС
		+ "Документы будут перепроведены целиком в порядке МоментВремени."
		+ Символы.ПС
		+ "Нагрузка ограничивается пакетами по 10 документов"
		+ " с паузой 0,3 сек. между пакетами."
		+ Символы.ПС
		+ "Закрытие месяца автоматически НЕ выполняется."
		+ Символы.ПС
		+ Символы.ПС
		+ "Продолжить?";

	ПараметрыПерепроведения = Новый Структура;
	ПараметрыПерепроведения.Вставить(
		"Номенклатура",
		НоменклатураДляПерепроведения);
	ПараметрыПерепроведения.Вставить("Начало", Информация.Начало);
	ПараметрыПерепроведения.Вставить("Конец", Информация.Конец);
	ПараметрыПерепроведения.Вставить("Документы", Информация.Документы);

	Оповещение = Новый ОписаниеОповещения(
		"ПослеПодтвержденияПерепроведения",
		ЭтотОбъект,
		ПараметрыПерепроведения);

	ПоказатьВопрос(
		Оповещение,
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры


&НаКлиенте
Процедура ПослеПодтвержденияПерепроведения(
	ОтветНаВопрос,
	ДополнительныеПараметры) Экспорт

	Если ОтветНаВопрос <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Если ДополнительныеПараметры = Неопределено Тогда
		Сообщить("Не переданы параметры перепроведения.");
		Возврат;
	КонецЕсли;

	Если СостояниеПерепроведения <> Неопределено Тогда
		Сообщить("Перепроведение уже выполняется.");
		Возврат;
	КонецЕсли;

	НоменклатураДляПерепроведения = ДополнительныеПараметры.Номенклатура;

	Если Не ЗначениеЗаполнено(НоменклатураДляПерепроведения) Тогда
		Сообщить("Не передана выбранная номенклатура.");
		Возврат;
	КонецЕсли;

	СостояниеПерепроведения = Новый Структура;
	СостояниеПерепроведения.Вставить("Номенклатура", НоменклатураДляПерепроведения);
	СостояниеПерепроведения.Вставить("Начало", ДополнительныеПараметры.Начало);
	СостояниеПерепроведения.Вставить("Конец", ДополнительныеПараметры.Конец);
	СостояниеПерепроведения.Вставить("Документы", ДополнительныеПараметры.Документы);
	СостояниеПерепроведения.Вставить("Индекс", 0);
	СостояниеПерепроведения.Вставить("Успешно", 0);
	СостояниеПерепроведения.Вставить("Пропущено", 0);
	СостояниеПерепроведения.Вставить("Ошибок", 0);
	СостояниеПерепроведения.Вставить("ДокументОшибки", "");
	СостояниеПерепроведения.Вставить("ТекстОшибки", "");

	ЗаписатьНачалоПерепроведенияВЖурналНаСервере(
		НоменклатураДляПерепроведения,
		ДополнительныеПараметры.Начало,
		ДополнительныеПараметры.Конец,
		ДополнительныеПараметры.Документы.Количество());

	Сообщить(
		"Перепроведение запущено: "
		+ Строка(НоменклатураДляПерепроведения)
		+ ". Пакет 10 документов, пауза 0,3 сек.");

	ОбработатьСледующийПакетПерепроведения();

КонецПроцедуры


&НаКлиенте
Процедура ОбработатьСледующийПакетПерепроведения()

	Если СостояниеПерепроведения = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Всего = СостояниеПерепроведения.Документы.Количество();

	Если СостояниеПерепроведения.Индекс >= Всего Тогда
		ЗавершитьПакетноеПерепроведение();
		Возврат;
	КонецЕсли;

	РазмерПакета = 10;
	Пакет = Новый Массив;
	НовыйИндекс = СостояниеПерепроведения.Индекс;

	Пока НовыйИндекс < Всего
		И Пакет.Количество() < РазмерПакета Цикл

		Пакет.Добавить(
			СостояниеПерепроведения.Документы[НовыйИндекс]);
		НовыйИндекс = НовыйИндекс + 1;

	КонецЦикла;

	Попытка

		РезультатПакета = ПерепровестиПакетНаСервере(
			Пакет,
			СостояниеПерепроведения.Номенклатура);

	Исключение

		СостояниеПерепроведения.Ошибок =
			СостояниеПерепроведения.Ошибок + 1;
		СостояниеПерепроведения.ТекстОшибки = ОписаниеОшибки();

		ЗаписатьОшибкаВЖурналНаСервере(
			"Вызов пакетного перепроведения",
			СостояниеПерепроведения.Номенклатура,
			СостояниеПерепроведения.ТекстОшибки);

		ЗавершитьПакетноеПерепроведение();
		Возврат;

	КонецПопытки;

	СостояниеПерепроведения.Успешно =
		СостояниеПерепроведения.Успешно + РезультатПакета.Успешно;
	СостояниеПерепроведения.Пропущено =
		СостояниеПерепроведения.Пропущено + РезультатПакета.Пропущено;
	СостояниеПерепроведения.Ошибок =
		СостояниеПерепроведения.Ошибок + РезультатПакета.Ошибок;
	СостояниеПерепроведения.Индекс = НовыйИндекс;

	Если РезультатПакета.Ошибок > 0 Тогда
		СостояниеПерепроведения.ДокументОшибки = РезультатПакета.ДокументОшибки;
		СостояниеПерепроведения.ТекстОшибки = РезультатПакета.ТекстОшибки;
		ЗавершитьПакетноеПерепроведение();
		Возврат;
	КонецЕсли;

	Если СостояниеПерепроведения.Индекс >= Всего Тогда
		ЗавершитьПакетноеПерепроведение();
		Возврат;
	КонецЕсли;

	// В УНФ нет лимита количества внутренних проведений как у REST API.
	// Пауза нужна только для сглаживания нагрузки на сервер 1С и СУБД.
	// Делаем ее на клиенте, потому что серверный ВызватьПаузу нельзя
	// использовать внутри обычного клиент-серверного вызова.
	ПодключитьОбработчикОжидания(
		"ПродолжитьПерепроведениеПослеПаузы",
		0.3,
		Истина);

КонецПроцедуры


&НаКлиенте
Процедура ПродолжитьПерепроведениеПослеПаузы() Экспорт

	ОбработатьСледующийПакетПерепроведения();

КонецПроцедуры


&НаКлиенте
Процедура ЗавершитьПакетноеПерепроведение()

	Если СостояниеПерепроведения = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НоменклатураДляПерепроведения = СостояниеПерепроведения.Номенклатура;

	ЗаписатьЗавершениеПерепроведенияВЖурналНаСервере(
		НоменклатураДляПерепроведения,
		СостояниеПерепроведения.Успешно,
		СостояниеПерепроведения.Пропущено,
		СостояниеПерепроведения.Ошибок,
		СостояниеПерепроведения.ДокументОшибки,
		СостояниеПерепроведения.ТекстОшибки);

	ТекстРезультата =
		"Перепроведение завершено."
		+ Символы.ПС
		+ "Позиция: "
		+ Строка(НоменклатураДляПерепроведения)
		+ Символы.ПС
		+ "Успешно: "
		+ Строка(СостояниеПерепроведения.Успешно)
		+ Символы.ПС
		+ "Пропущено: "
		+ Строка(СостояниеПерепроведения.Пропущено)
		+ Символы.ПС
		+ "Ошибок: "
		+ Строка(СостояниеПерепроведения.Ошибок);

	Если СостояниеПерепроведения.Ошибок > 0 Тогда
		ТекстРезультата =
			ТекстРезультата
			+ Символы.ПС
			+ "Документ с ошибкой: "
			+ СостояниеПерепроведения.ДокументОшибки
			+ Символы.ПС
			+ "Ошибка: "
			+ СостояниеПерепроведения.ТекстОшибки;
	КонецЕсли;

	Ошибок = СостояниеПерепроведения.Ошибок;
	СостояниеПерепроведения = Неопределено;

	Сообщить(ТекстРезультата);

	Если Ошибок = 0 И ПроверитьПериодНаКлиенте() Тогда
		Попытка
			ПроверитьНаСервере();
		Исключение
			Сообщить(
				"Перепроведение выполнено, но не удалось повторить анализ:"
				+ Символы.ПС
				+ ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры


&НаСервере
Процедура ДобавитьДокументПерепроведения(
	ТаблицаДокументов,
	УникальныеДокументы,
	СсылкаДокумента,
	ПериодДокумента,
	Источник)

	Если Не ЗначениеЗаполнено(СсылкаДокумента) Тогда
		Возврат;
	КонецЕсли;

	Если УникальныеДокументы.Получить(СсылкаДокумента) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	МетаДокумента = Метаданные.НайтиПоТипу(
		ТипЗнч(СсылкаДокумента));

	Если МетаДокумента = Неопределено Тогда
		Возврат;
	КонецЕсли;

	УникальныеДокументы.Вставить(
		СсылкаДокумента,
		Истина);

	НоваяСтрока = ТаблицаДокументов.Добавить();
	НоваяСтрока.Период = ПериодДокумента;
	НоваяСтрока.Ссылка = СсылкаДокумента;
	НоваяСтрока.ВидДокумента = МетаДокумента.Имя;
	НоваяСтрока.Источник = Источник;

	// МоментВремени задает платформенный порядок документов, в том числе
	// когда несколько документов имеют одинаковую дату и секунду.
	НоваяСтрока.Момент = СсылкаДокумента.МоментВремени();

КонецПроцедуры


&НаСервере
Функция ПолучитьИменаРегистровДляЦепочки()

	Регистры = Новый Массив;
	Регистры.Добавить("Запасы");
	Регистры.Добавить("ЗапасыНаСкладах");
	Регистры.Добавить("РезервыТоваровОрганизаций");
	Регистры.Добавить("ПотребностьВЗапасах");
	Регистры.Добавить("ЗапасыКПоступлениюНаСклады");
	Регистры.Добавить("ЗапасыКРасходуСоСкладов");
	Регистры.Добавить("ГрафикДвиженияЗапасов");
	Регистры.Добавить("Закупки");
	Регистры.Добавить("Продажи");

	Возврат Регистры;

КонецФункции


&НаСервере
Функция ПолучитьПервуюДатуДвиженияВРегистре(
	ИмяРегистра,
	ВыбраннаяНоменклатура)

	МетаРегистра = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);

	Если МетаРегистра = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если МетаРегистра.Измерения.Найти("Номенклатура") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	МИНИМУМ(Движения.Период) КАК ПерваяДата
	|ИЗ
	|	РегистрНакопления.%ИМЯРЕГИСТРА% КАК Движения
	|ГДЕ
	|	Движения.Номенклатура = &Номенклатура";

	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"%ИМЯРЕГИСТРА%",
		ИмяРегистра);

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр(
		"Номенклатура",
		ВыбраннаяНоменклатура);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.ПерваяДата) Тогда
			Возврат Выборка.ПерваяДата;
		КонецЕсли;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции


&НаСервере
Функция ПолучитьПервуюДатуДвиженияНоменклатуры(
	ВыбраннаяНоменклатура)

	ПерваяДата = Неопределено;

	Для Каждого ИмяРегистра Из ПолучитьИменаРегистровДляЦепочки() Цикл

		ДатаРегистра = ПолучитьПервуюДатуДвиженияВРегистре(
			ИмяРегистра,
			ВыбраннаяНоменклатура);

		Если ДатаРегистра = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если ПерваяДата = Неопределено
			ИЛИ ДатаРегистра < ПерваяДата Тогда
			ПерваяДата = ДатаРегистра;
		КонецЕсли;

	КонецЦикла;

	Возврат ПерваяДата;

КонецФункции


&НаСервере
Функция ПолучитьПериодИсправленияНаСервере(
	ВыбраннаяНоменклатура)

	Если Не ЗначениеЗаполнено(ВыбраннаяНоменклатура) Тогда
		Возврат Новый Структура(
			"Найдено,Начало,Конец",
			Ложь,
			Неопределено,
			КонецДня(ТекущаяДата()));
	КонецЕсли;

	ПерваяДата = ПолучитьПервуюДатуДвиженияНоменклатуры(
		ВыбраннаяНоменклатура);

	Если ПерваяДата = Неопределено Тогда
		Возврат Новый Структура(
			"Найдено,Начало,Конец",
			Ложь,
			Неопределено,
			КонецДня(ТекущаяДата()));
	КонецЕсли;

	Возврат Новый Структура(
		"Найдено,Начало,Конец",
		Истина,
		НачалоДня(ПерваяДата),
		КонецДня(ТекущаяДата()));

КонецФункции


&НаСервере
Процедура ДобавитьДокументыИзРегистра(
	ИмяРегистра,
	НачалоПериода,
	КонецПериода,
	ВыбраннаяНоменклатура,
	ТаблицаДокументов,
	УникальныеДокументы)

	МетаРегистра = Метаданные.РегистрыНакопления.Найти(
		ИмяРегистра);

	Если МетаРегистра = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Для исправления работаем ТОЛЬКО по выбранной позиции.
	Если Не ЗначениеЗаполнено(ВыбраннаяНоменклатура) Тогда
		Возврат;
	КонецЕсли;

	Если МетаРегистра.Измерения.Найти("Номенклатура") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Движения.Регистратор КАК Регистратор,
	|	МИНИМУМ(Движения.Период) КАК Период
	|ИЗ
	|	РегистрНакопления.%ИМЯРЕГИСТРА% КАК Движения
	|ГДЕ
	|	Движения.Период >= &НачалоПериода
	|	И Движения.Период <= &КонецПериода
	|	И Движения.Номенклатура = &Номенклатура
	|СГРУППИРОВАТЬ ПО
	|	Движения.Регистратор";

	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса,
		"%ИМЯРЕГИСТРА%",
		ИмяРегистра);

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Номенклатура", ВыбраннаяНоменклатура);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		ДобавитьДокументПерепроведения(
			ТаблицаДокументов,
			УникальныеДокументы,
			Выборка.Регистратор,
			Выборка.Период,
			ИмяРегистра);

	КонецЦикла;

КонецПроцедуры


&НаСервере
Функция ПолучитьДокументыДляПерепроведения(
	НачалоПериода,
	КонецПериода,
	ВыбраннаяНоменклатура)

	ТаблицаДокументов = Новый ТаблицаЗначений;
	ТаблицаДокументов.Колонки.Добавить("Момент");
	ТаблицаДокументов.Колонки.Добавить("Период");
	ТаблицаДокументов.Колонки.Добавить("Ссылка");
	ТаблицаДокументов.Колонки.Добавить("ВидДокумента");
	ТаблицаДокументов.Колонки.Добавить("Источник");

	УникальныеДокументы = Новый Соответствие;

	Для Каждого ИмяРегистра Из ПолучитьИменаРегистровДляЦепочки() Цикл

		ДобавитьДокументыИзРегистра(
			ИмяРегистра,
			НачалоПериода,
			КонецПериода,
			ВыбраннаяНоменклатура,
			ТаблицаДокументов,
			УникальныеДокументы);

	КонецЦикла;

	// Никакой сортировки по типам документов. Только реальный платформенный
	// МоментВремени документа.
	ТаблицаДокументов.Сортировать("Момент");

	Возврат ТаблицаДокументов;

КонецФункции


&НаСервере
Функция ПолучитьИнформациюПерепроведенияНаСервере(
	ВыбраннаяНоменклатура)

	ПериодИсправления = ПолучитьПериодИсправленияНаСервере(
		ВыбраннаяНоменклатура);

	ПустойМассив = Новый Массив;

	Если Не ПериодИсправления.Найдено Тогда
		Возврат Новый Структура(
			"Количество,Начало,Конец,Документы",
			0,
			ПериодИсправления.Конец,
			ПериодИсправления.Конец,
			ПустойМассив);
	КонецЕсли;

	ТаблицаДокументов = ПолучитьДокументыДляПерепроведения(
		ПериодИсправления.Начало,
		ПериодИсправления.Конец,
		ВыбраннаяНоменклатура);

	МассивДокументов = Новый Массив;

	Для Каждого СтрокаДокумента Из ТаблицаДокументов Цикл

		ОписаниеДокумента = Новый Структура;
		ОписаниеДокумента.Вставить("Ссылка", СтрокаДокумента.Ссылка);
		ОписаниеДокумента.Вставить("Период", СтрокаДокумента.Период);
		ОписаниеДокумента.Вставить("ВидДокумента", СтрокаДокумента.ВидДокумента);
		МассивДокументов.Добавить(ОписаниеДокумента);

	КонецЦикла;

	Возврат Новый Структура(
		"Количество,Начало,Конец,Документы",
		МассивДокументов.Количество(),
		ПериодИсправления.Начало,
		ПериодИсправления.Конец,
		МассивДокументов);

КонецФункции


&НаСервере
Функция ПерепровестиПакетНаСервере(
	ПакетДокументов,
	ВыбраннаяНоменклатура)

	Если Не ЗначениеЗаполнено(ВыбраннаяНоменклатура) Тогда
		ВызватьИсключение "Для исправления необходимо выбрать номенклатуру.";
	КонецЕсли;

	Успешно = 0;
	Пропущено = 0;
	Ошибок = 0;
	ДокументОшибки = "";
	ТекстОшибки = "";

	Для Каждого ОписаниеДокумента Из ПакетДокументов Цикл

		СсылкаДокумента = ОписаниеДокумента.Ссылка;
		ВидДокумента = ОписаниеДокумента.ВидДокумента;

		Попытка

			ОбъектДокумента = СсылкаДокумента.ПолучитьОбъект();
			МетаДокумента = Метаданные.НайтиПоТипу(ТипЗнч(СсылкаДокумента));

			Если Не ОбъектДокумента.Проведен Тогда

				Пропущено = Пропущено + 1;
				ЗаписатьВЖурналСебестоимости(
					"ДиагностикаСебестоимостиУНФ.Исправление.ПропущенДокумент",
					УровеньЖурналаРегистрации.Предупреждение,
					МетаДокумента,
					СсылкаДокумента,
					"Номенклатура: " + Строка(ВыбраннаяНоменклатура)
					+ ". Документ не проведен, поэтому пропущен.");

				Продолжить;

			КонецЕсли;

			ОбъектДокумента.Записать(
				РежимЗаписиДокумента.Проведение,
				РежимПроведенияДокумента.Неоперативный);

			Успешно = Успешно + 1;

			ЗаписатьВЖурналСебестоимости(
				"ДиагностикаСебестоимостиУНФ.Исправление.ДокументПерепроведен",
				УровеньЖурналаРегистрации.Информация,
				МетаДокумента,
				СсылкаДокумента,
				"Номенклатура: " + Строка(ВыбраннаяНоменклатура)
				+ ". Вид документа: " + ВидДокумента + ".");

		Исключение

			Ошибок = Ошибок + 1;
			ДокументОшибки = Строка(СсылкаДокумента);
			ТекстОшибки = ОписаниеОшибки();

			Попытка
				МетаДокумента = Метаданные.НайтиПоТипу(ТипЗнч(СсылкаДокумента));
			Исключение
				МетаДокумента = Неопределено;
			КонецПопытки;

			ЗаписатьВЖурналСебестоимости(
				"ДиагностикаСебестоимостиУНФ.Исправление.Ошибка",
				УровеньЖурналаРегистрации.Ошибка,
				МетаДокумента,
				СсылкаДокумента,
				"Номенклатура: " + Строка(ВыбраннаяНоменклатура)
				+ ". Ошибка: " + ТекстОшибки);

			Прервать;

		КонецПопытки;

	КонецЦикла;

	Возврат Новый Структура(
		"Успешно,Пропущено,Ошибок,ДокументОшибки,ТекстОшибки",
		Успешно,
		Пропущено,
		Ошибок,
		ДокументОшибки,
		ТекстОшибки);

КонецФункции


&НаСервере
Процедура ЗаписатьВЖурналСебестоимости(
	ИмяСобытия,
	Уровень,
	ОбъектМетаданных = Неопределено,
	Данные = Неопределено,
	Комментарий = "")

	Попытка

		ЗаписьЖурналаРегистрации(
			ИмяСобытия,
			Уровень,
			ОбъектМетаданных,
			Данные,
			Лев(Комментарий, 5000));

	Исключение
		// Ошибка записи в ЖР не должна останавливать анализ или перепроведение.
	КонецПопытки;

КонецПроцедуры


&НаСервере
Процедура ЗаписатьНачалоПерепроведенияВЖурналНаСервере(
	НоменклатураДляПерепроведения,
	НачалоПериода,
	КонецПериода,
	КоличествоДокументов)

	ЗаписатьВЖурналСебестоимости(
		"ДиагностикаСебестоимостиУНФ.Исправление.Начало",
		УровеньЖурналаРегистрации.Информация,
		,
		НоменклатураДляПерепроведения,
		"Номенклатура: " + Строка(НоменклатураДляПерепроведения)
		+ ". Период: " + Формат(НачалоПериода, "ДФ=dd.MM.yyyy HH:mm:ss")
		+ " - " + Формат(КонецПериода, "ДФ=dd.MM.yyyy HH:mm:ss")
		+ ". Документов: " + Строка(КоличествоДокументов)
		+ ". Пакет: 10 документов, задержка между пакетами: 0,3 сек.");

КонецПроцедуры


&НаСервере
Процедура ЗаписатьЗавершениеПерепроведенияВЖурналНаСервере(
	НоменклатураДляПерепроведения,
	Успешно,
	Пропущено,
	Ошибок,
	ДокументОшибки,
	ТекстОшибки)

	Уровень = ?(
		Ошибок > 0,
		УровеньЖурналаРегистрации.Ошибка,
		УровеньЖурналаРегистрации.Информация);

	Комментарий =
		"Номенклатура: " + Строка(НоменклатураДляПерепроведения)
		+ ". Успешно: " + Строка(Успешно)
		+ ". Пропущено: " + Строка(Пропущено)
		+ ". Ошибок: " + Строка(Ошибок);

	Если Ошибок > 0 Тогда
		Комментарий = Комментарий
			+ ". Документ ошибки: " + ДокументОшибки
			+ ". Ошибка: " + ТекстОшибки;
	КонецЕсли;

	ЗаписатьВЖурналСебестоимости(
		"ДиагностикаСебестоимостиУНФ.Исправление.Завершено",
		Уровень,
		,
		НоменклатураДляПерепроведения,
		Комментарий);

КонецПроцедуры


&НаСервере
Процедура ЗаписатьОшибкаВЖурналНаСервере(
	Этап,
	Данные,
	ТекстОшибки)

	ЗаписатьВЖурналСебестоимости(
		"ДиагностикаСебестоимостиУНФ.Ошибка",
		УровеньЖурналаРегистрации.Ошибка,
		,
		Данные,
		"Этап: " + Этап + ". Ошибка: " + ТекстОшибки);

КонецПроцедуры


&НаСервере
Процедура ДобавитьПроблему(
	Критичность,
	Проблема,
	ДатаПроблемы,
	Регистратор,
	НоменклатураПроблемы,
	Количество,
	Стоимость,
	Причина)

	НоваяСтрока = Результат.Добавить();
	НоваяСтрока.Критичность = Критичность;
	НоваяСтрока.Проблема = Проблема;
	НоваяСтрока.Дата = ДатаПроблемы;

	Если ЗначениеЗаполнено(Регистратор) Тогда
		НоваяСтрока.Документ = Строка(Регистратор);
	Иначе
		НоваяСтрока.Документ = "Проблема существовала на начало периода";
	КонецЕсли;

	Если ЗначениеЗаполнено(НоменклатураПроблемы) Тогда
		НоваяСтрока.Номенклатура = Строка(НоменклатураПроблемы);
	Иначе
		НоваяСтрока.Номенклатура = "";
	КонецЕсли;

	НоваяСтрока.Количество = Количество;
	НоваяСтрока.Стоимость = Стоимость;
	НоваяСтрока.Причина = Причина;

КонецПроцедуры


&НаСервере
Процедура ДобавитьПроблемуЕслиНоваяПозиция(
	УжеДобавленныеПозиции,
	Критичность,
	Проблема,
	ДатаПроблемы,
	Регистратор,
	НоменклатураПроблемы,
	Количество,
	Стоимость,
	Причина)

	Если Не ЗначениеЗаполнено(НоменклатураПроблемы) Тогда
		Возврат;
	КонецЕсли;

	// В части 1 нужна именно выборка ПОЗИЦИЙ, а не сотни строк по аналитикам.
	// Поэтому одна номенклатура попадает в результат только один раз.
	Если УжеДобавленныеПозиции.Получить(НоменклатураПроблемы) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	УжеДобавленныеПозиции.Вставить(НоменклатураПроблемы, Истина);

	ДобавитьПроблему(
		Критичность,
		Проблема,
		ДатаПроблемы,
		Регистратор,
		НоменклатураПроблемы,
		Количество,
		Стоимость,
		Причина);

КонецПроцедуры


&НаСервере
Процедура ПроверитьНаСервере()

	Результат.Очистить();

	НачалоПроверки = НачалоДня(ДатаНачала);
	КонецПроверки = КонецДня(ДатаОкончания);

	ТочностьКоличество = 0.000001;
	ТочностьСумма = 0.01;

	ЗаписатьВЖурналСебестоимости(
		"ДиагностикаСебестоимостиУНФ.Анализ.Начало",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		"Период анализа: "
		+ Формат(НачалоПроверки, "ДФ=dd.MM.yyyy HH:mm:ss")
		+ " - "
		+ Формат(КонецПроверки, "ДФ=dd.MM.yyyy HH:mm:ss"));

	// В результате держим максимум одну строку на номенклатуру.
	УжеДобавленныеПозиции = Новый Соответствие;


	//////////////////////////////////////////////////////////////////////////
	// ЭТАП 1. Состояние на начало выбранного периода.
	//
	// Если позиция уже сломана на начало периода, мы честно показываем это:
	// причина возникла раньше. Для исправления это не проблема — в части 2
	// выбранная позиция будет перепроведена от самого первого движения.
	//////////////////////////////////////////////////////////////////////////

	Запрос = Новый Запрос;

	Запрос.Текст =
	"ВЫБРАТЬ
	|    Остатки.Организация КАК Организация,
	|    Остатки.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|    Остатки.Номенклатура КАК Номенклатура,
	|    Остатки.Характеристика КАК Характеристика,
	|    Остатки.Партия КАК Партия,
	|    Остатки.СчетУчета КАК СчетУчета,
	|    Остатки.ЗаказПокупателя КАК ЗаказПокупателя,
	|    Остатки.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|    Остатки.КоличествоОстаток КАК Количество,
	|    Остатки.СуммаОстаток КАК Сумма
	|ИЗ
	|    РегистрНакопления.Запасы.Остатки(&НачалоПериода) КАК Остатки";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПроверки);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Если Не ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;

		Количество = Выборка.Количество;
		Сумма = Выборка.Сумма;
		ТипПроблемы = "";
		Описание = "";
		Критичность = "ИСТОК";

		Если Количество < -ТочностьКоличество Тогда

			ТипПроблемы = "ОТРИЦАТЕЛЬНОЕ КОЛИЧЕСТВО НА НАЧАЛО ПЕРИОДА";
			Описание =
				"На начало выбранного периода количество уже отрицательное. "
				+ "Проблема появилась раньше выбранной даты.";

		ИначеЕсли Количество > ТочностьКоличество
			И Сумма < -ТочностьСумма Тогда

			ТипПроблемы = "ОТРИЦАТЕЛЬНАЯ СТОИМОСТЬ НА НАЧАЛО ПЕРИОДА";
			Описание =
				"На начало выбранного периода количество положительное, "
				+ "а стоимость отрицательная.";

		ИначеЕсли Количество > ТочностьКоличество
			И Сумма >= -ТочностьСумма
			И Сумма <= ТочностьСумма Тогда

			ТипПроблемы = "КОЛИЧЕСТВО БЕЗ СТОИМОСТИ НА НАЧАЛО ПЕРИОДА";
			Описание =
				"На начало выбранного периода товар уже имеет количество, "
				+ "но стоимость около нуля.";

		ИначеЕсли Количество >= -ТочностьКоличество
			И Количество <= ТочностьКоличество
			И (Сумма < -ТочностьСумма ИЛИ Сумма > ТочностьСумма) Тогда

			ТипПроблемы = "СТОИМОСТЬ БЕЗ КОЛИЧЕСТВА НА НАЧАЛО ПЕРИОДА";
			Описание =
				"На начало выбранного периода количество около нуля, "
				+ "но в стоимостном учете осталась сумма.";

		КонецЕсли;

		Если ТипПроблемы <> "" Тогда

			ДобавитьПроблемуЕслиНоваяПозиция(
				УжеДобавленныеПозиции,
				Критичность,
				ТипПроблемы,
				НачалоПроверки,
				Неопределено,
				Выборка.Номенклатура,
				Количество,
				Сумма,
				Описание
				+ " | Структурная единица: "
				+ Строка(Выборка.СтруктурнаяЕдиница)
				+ " | Партия: "
				+ Строка(Выборка.Партия)
				+ " | Счет учета: "
				+ Строка(Выборка.СчетУчета));

		КонецЕсли;

	КонецЦикла;


	//////////////////////////////////////////////////////////////////////////
	// ЭТАП 2. Ищем документ внутри выбранного периода, после которого
	// стоимостное состояние позиции стало явно некорректным.
	//////////////////////////////////////////////////////////////////////////

	Запрос = Новый Запрос;

	Запрос.Текст =
	"ВЫБРАТЬ
	|    Данные.Период КАК Период,
	|    Данные.Регистратор КАК Регистратор,
	|    Данные.Организация КАК Организация,
	|    Данные.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|    Данные.Номенклатура КАК Номенклатура,
	|    Данные.Характеристика КАК Характеристика,
	|    Данные.Партия КАК Партия,
	|    Данные.СчетУчета КАК СчетУчета,
	|    Данные.ЗаказПокупателя КАК ЗаказПокупателя,
	|    Данные.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|    Данные.КоличествоНачальныйОстаток КАК КоличествоДо,
	|    Данные.СуммаНачальныйОстаток КАК СуммаДо,
	|    Данные.КоличествоОборот КАК КоличествоДвижение,
	|    Данные.СуммаОборот КАК СуммаДвижение,
	|    Данные.КоличествоКонечныйОстаток КАК КоличествоПосле,
	|    Данные.СуммаКонечныйОстаток КАК СуммаПосле
	|ИЗ
	|    РегистрНакопления.Запасы.ОстаткиИОбороты(
	|        &НачалоПериода,
	|        &КонецПериода,
	|        Регистратор,
	|        ДвиженияИГраницыПериода,
	|    ) КАК Данные
	|УПОРЯДОЧИТЬ ПО
	|    Данные.Период";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПроверки);
	Запрос.УстановитьПараметр("КонецПериода", КонецПроверки);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Если Не ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;

		// По этой позиции уже нашли более раннюю/очевидную проблему.
		Если УжеДобавленныеПозиции.Получить(Выборка.Номенклатура) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(Выборка.Регистратор) Тогда
			Продолжить;
		КонецЕсли;

		КоличествоДо = Выборка.КоличествоДо;
		СуммаДо = Выборка.СуммаДо;
		КоличествоДвижение = Выборка.КоличествоДвижение;
		СуммаДвижение = Выборка.СуммаДвижение;
		КоличествоПосле = Выборка.КоличествоПосле;
		СуммаПосле = Выборка.СуммаПосле;

		ТипПроблемы = "";
		Причина = "";
		Критичность = "КРИТИЧНО";

		Если КоличествоДо >= -ТочностьКоличество
			И КоличествоПосле < -ТочностьКоличество Тогда

			ТипПроблемы = "ДОКУМЕНТ СОЗДАЛ ОТРИЦАТЕЛЬНЫЙ ОСТАТОК";
			Причина =
				"До документа было "
				+ Строка(КоличествоДо)
				+ ", движение количества "
				+ Строка(КоличествоДвижение)
				+ ", после документа "
				+ Строка(КоличествоПосле)
				+ ".";

		ИначеЕсли КоличествоПосле > ТочностьКоличество
			И СуммаПосле >= -ТочностьСумма
			И СуммаПосле <= ТочностьСумма
			И Не (
				КоличествоДо > ТочностьКоличество
				И СуммаДо >= -ТочностьСумма
				И СуммаДо <= ТочностьСумма) Тогда

			ТипПроблемы = "ДОКУМЕНТ СОЗДАЛ ТОВАР БЕЗ СТОИМОСТИ";
			Причина =
				"До: "
				+ Строка(КоличествоДо)
				+ " / "
				+ Строка(СуммаДо)
				+ "; движение: "
				+ Строка(КоличествоДвижение)
				+ " / "
				+ Строка(СуммаДвижение)
				+ "; после: "
				+ Строка(КоличествоПосле)
				+ " / "
				+ Строка(СуммаПосле)
				+ ".";

		ИначеЕсли КоличествоПосле > ТочностьКоличество
			И СуммаПосле < -ТочностьСумма
			И Не (
				КоличествоДо > ТочностьКоличество
				И СуммаДо < -ТочностьСумма) Тогда

			ТипПроблемы = "ДОКУМЕНТ СОЗДАЛ ОТРИЦАТЕЛЬНУЮ СТОИМОСТЬ";
			Причина =
				"До: "
				+ Строка(КоличествоДо)
				+ " / "
				+ Строка(СуммаДо)
				+ "; движение суммы: "
				+ Строка(СуммаДвижение)
				+ "; после: "
				+ Строка(КоличествоПосле)
				+ " / "
				+ Строка(СуммаПосле)
				+ ".";

		ИначеЕсли КоличествоПосле >= -ТочностьКоличество
			И КоличествоПосле <= ТочностьКоличество
			И (СуммаПосле < -ТочностьСумма ИЛИ СуммаПосле > ТочностьСумма)
			И (КоличествоДо < -ТочностьКоличество ИЛИ КоличествоДо > ТочностьКоличество) Тогда

			ТипПроблемы = "ДОКУМЕНТ ОСТАВИЛ СУММОВОЙ ХВОСТ";
			Причина =
				"После документа количество стало около нуля, "
				+ "но сумма осталась "
				+ Строка(СуммаПосле)
				+ ".";

		КонецЕсли;

		Если ТипПроблемы <> "" Тогда

			ДобавитьПроблемуЕслиНоваяПозиция(
				УжеДобавленныеПозиции,
				Критичность,
				ТипПроблемы,
				Выборка.Период,
				Выборка.Регистратор,
				Выборка.Номенклатура,
				КоличествоПосле,
				СуммаПосле,
				Причина
				+ " | Структурная единица: "
				+ Строка(Выборка.СтруктурнаяЕдиница)
				+ " | Партия: "
				+ Строка(Выборка.Партия)
				+ " | Счет учета: "
				+ Строка(Выборка.СчетУчета));

		КонецЕсли;

	КонецЦикла;


	//////////////////////////////////////////////////////////////////////////
	// ЭТАП 3. Проверяем фактически записанную себестоимость продаж.
	//////////////////////////////////////////////////////////////////////////

	Если Метаданные.РегистрыНакопления.Найти("Продажи") <> Неопределено Тогда

		Запрос = Новый Запрос;

		Запрос.Текст =
		"ВЫБРАТЬ
		|    Продажи.Период КАК Период,
		|    Продажи.Регистратор КАК Регистратор,
		|    Продажи.Номенклатура КАК Номенклатура,
		|    Продажи.Количество КАК Количество,
		|    Продажи.Себестоимость КАК Себестоимость
		|ИЗ
		|    РегистрНакопления.Продажи КАК Продажи
		|ГДЕ
		|    Продажи.Период >= &НачалоПериода
		|    И Продажи.Период <= &КонецПериода
		|УПОРЯДОЧИТЬ ПО
		|    Продажи.Период";

		Запрос.УстановитьПараметр("НачалоПериода", НачалоПроверки);
		Запрос.УстановитьПараметр("КонецПериода", КонецПроверки);

		Выборка = Запрос.Выполнить().Выбрать();

		Пока Выборка.Следующий() Цикл

			Если УжеДобавленныеПозиции.Получить(Выборка.Номенклатура) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Если Выборка.Количество > ТочностьКоличество Тогда

				Если Выборка.Себестоимость < -ТочностьСумма Тогда

					ДобавитьПроблемуЕслиНоваяПозиция(
						УжеДобавленныеПозиции,
						"КРИТИЧНО",
						"ПРОДАЖА С ОТРИЦАТЕЛЬНОЙ СЕБЕСТОИМОСТЬЮ",
						Выборка.Период,
						Выборка.Регистратор,
						Выборка.Номенклатура,
						Выборка.Количество,
						Выборка.Себестоимость,
						"В регистре Продажи записана отрицательная себестоимость.");

				ИначеЕсли Выборка.Себестоимость >= -ТочностьСумма
					И Выборка.Себестоимость <= ТочностьСумма Тогда

					ДобавитьПроблемуЕслиНоваяПозиция(
						УжеДобавленныеПозиции,
						"ПРОВЕРИТЬ",
						"ПРОДАЖА С НУЛЕВОЙ СЕБЕСТОИМОСТЬЮ",
						Выборка.Период,
						Выборка.Регистратор,
						Выборка.Номенклатура,
						Выборка.Количество,
						Выборка.Себестоимость,
						"Количество продажи есть, а ресурс Продажи.Себестоимость равен нулю.");

				КонецЕсли;

			КонецЕсли;

		КонецЦикла;

	КонецЕсли;

	Результат.Сортировать("Номенклатура");

	ЗаписатьВЖурналСебестоимости(
		"ДиагностикаСебестоимостиУНФ.Анализ.Завершено",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		"Период: "
		+ Формат(НачалоПроверки, "ДФ=dd.MM.yyyy")
		+ " - "
		+ Формат(КонецПроверки, "ДФ=dd.MM.yyyy")
		+ ". Найдено проблемных позиций: "
		+ Строка(Результат.Количество()));

КонецПроцедуры

