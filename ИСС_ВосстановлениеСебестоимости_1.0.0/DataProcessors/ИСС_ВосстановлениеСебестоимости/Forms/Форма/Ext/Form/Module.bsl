&НаКлиенте
Перем АдресПлана;
Перем КоличествоДокументовПлана;
Перем НачалоПлана;
Перем КонецПлана;
Перем ОшибокЧтенияПлана;
Перем СостояниеПерепроведения;
Перем ЗапрошенаОстановка;

#Область Инициализация

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПредыдущийМесяц = ДобавитьМесяц(ТекущаяДата(), -1);

	Если Не ЗначениеЗаполнено(ДатаНачала) Тогда
		ДатаНачала = НачалоМесяца(ПредыдущийМесяц);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончания = КонецМесяца(ПредыдущийМесяц);
	КонецЕсли;

	РезервнаяКопияПодтверждена = Ложь;
	Состояние = "Сначала сформируйте план. На этом шаге данные не изменяются.";
	Протокол = "Версия расширения: 1.0.0";

КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура СформироватьПлан(Команда)

	Если СостояниеПерепроведения <> Неопределено Тогда
		Сообщить("Нельзя перестроить план во время перепроведения.");
		Возврат;
	КонецЕсли;

	Если Не ПроверитьПериод() Тогда
		Возврат;
	КонецЕсли;

	АдресПлана = Неопределено;
	КоличествоДокументовПлана = 0;
	ОшибокЧтенияПлана = 0;
	Состояние = "Формируется план. Выполняется только чтение данных...";

	Попытка
		Результат = СформироватьПланНаСервере();
	Исключение
		АдресПлана = Неопределено;
		КоличествоДокументовПлана = 0;
		Состояние = "План не сформирован.";
		Протокол = "Ошибка формирования плана:" + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Сообщить(Протокол);
		Возврат;
	КонецПопытки;

	АдресПлана = Результат.АдресПлана;
	КоличествоДокументовПлана = Результат.Количество;
	НачалоПлана = Результат.Начало;
	КонецПлана = Результат.Конец;
	ОшибокЧтенияПлана = Результат.ОшибокЧтения;
	Протокол = Результат.Протокол;

	Если Результат.Количество = 0 Тогда
		Состояние = "В периоде нет проведенных документов.";
	ИначеЕсли Результат.ОшибокЧтения > 0 Тогда
		Состояние = "План сформирован с ошибками чтения. Перепроведение заблокировано.";
	Иначе
		Состояние = "План готов. Документов: " + Строка(Результат.Количество) + ".";
	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура Перепровести(Команда)

	Если СостояниеПерепроведения <> Неопределено Тогда
		Сообщить("Перепроведение уже выполняется.");
		Возврат;
	КонецЕсли;

	Если Не ПроверитьПериод() Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(АдресПлана) Или КоличествоДокументовПлана = 0 Тогда
		Сообщить("Сначала сформируйте план перепроведения.");
		Возврат;
	КонецЕсли;

	Если ОшибокЧтенияПлана > 0 Тогда
		Сообщить("План содержит ошибки чтения документов. Перепроведение заблокировано.");
		Возврат;
	КонецЕсли;

	Если НачалоДня(ДатаНачала) <> НачалоПлана Или КонецДня(ДатаОкончания) <> КонецПлана Тогда
		Сообщить("После формирования плана период был изменен. Сформируйте план повторно.");
		Возврат;
	КонецЕсли;

	Если Не РезервнаяКопияПодтверждена Тогда
		Сообщить("Подтвердите, что свежая резервная копия создана и проверена.");
		Возврат;
	КонецЕсли;

	ТекстВопроса =
		"Будут неоперативно перепроведены ВСЕ проведенные документы периода в порядке МоментВремени."
		+ Символы.ПС + Символы.ПС
		+ "Период: " + Формат(НачалоПлана, "ДФ=dd.MM.yyyy")
		+ " - " + Формат(КонецПлана, "ДФ=dd.MM.yyyy")
		+ Символы.ПС
		+ "Документов: " + Строка(КоличествоДокументовПлана)
		+ Символы.ПС + Символы.ПС
		+ "Убедитесь, что пользователи вышли из базы, а обмены и фоновые задания остановлены."
		+ Символы.ПС
		+ "После выполнения потребуется последовательно повторить закрытие месяцев."
		+ Символы.ПС + Символы.ПС
		+ "Продолжить?";

	Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияПерепроведения", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры


&НаКлиенте
Процедура ПослеПодтвержденияПерепроведения(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	СостояниеПерепроведения = Новый Структура;
	СостояниеПерепроведения.Вставить("Индекс", 0);
	СостояниеПерепроведения.Вставить("Успешно", 0);
	СостояниеПерепроведения.Вставить("Пропущено", 0);
	СостояниеПерепроведения.Вставить("Ошибок", 0);
	СостояниеПерепроведения.Вставить("ДокументОшибки", "");
	СостояниеПерепроведения.Вставить("ТекстОшибки", "");
	ЗапрошенаОстановка = Ложь;

	ЗаписатьНачалоВЖурналНаСервере(НачалоПлана, КонецПлана, КоличествоДокументовПлана);
	Состояние = "Перепроведение запущено.";
	ОбработатьСледующийПакет();

КонецПроцедуры


&НаКлиенте
Процедура Остановить(Команда)

	Если СостояниеПерепроведения = Неопределено Тогда
		Сообщить("Перепроведение сейчас не выполняется.");
		Возврат;
	КонецЕсли;

	ЗапрошенаОстановка = Истина;
	Состояние = "Запрошена остановка. Текущий пакет будет завершен.";

КонецПроцедуры


&НаКлиенте
Процедура Проверить(Команда)

	Если Не ПроверитьПериод() Тогда
		Возврат;
	КонецЕсли;

	Состояние = "Выполняется быстрый контроль регистра Запасы...";

	Попытка
		РезультатКонтроля = ВыполнитьБыстрыйКонтрольНаСервере();
		Протокол = Протокол + Символы.ПС + Символы.ПС + РезультатКонтроля;
		Состояние = "Быстрый контроль завершен.";
	Исключение
		Состояние = "Быстрый контроль завершен с ошибкой.";
		Сообщить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область КлиентскоеПакетноеВыполнение

&НаКлиенте
Процедура ОбработатьСледующийПакет()

	Если СостояниеПерепроведения = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если СостояниеПерепроведения.Индекс >= КоличествоДокументовПлана Тогда
		ЗавершитьПерепроведение(Ложь);
		Возврат;
	КонецЕсли;

	Попытка
		РезультатПакета = ПерепровестиПакетНаСервере(АдресПлана, СостояниеПерепроведения.Индекс, 10);
	Исключение
		СостояниеПерепроведения.Ошибок = СостояниеПерепроведения.Ошибок + 1;
		СостояниеПерепроведения.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗавершитьПерепроведение(Ложь);
		Возврат;
	КонецПопытки;

	СостояниеПерепроведения.Индекс = РезультатПакета.СледующийИндекс;
	СостояниеПерепроведения.Успешно = СостояниеПерепроведения.Успешно + РезультатПакета.Успешно;
	СостояниеПерепроведения.Пропущено = СостояниеПерепроведения.Пропущено + РезультатПакета.Пропущено;
	СостояниеПерепроведения.Ошибок = СостояниеПерепроведения.Ошибок + РезультатПакета.Ошибок;

	Если РезультатПакета.Ошибок > 0 Тогда
		СостояниеПерепроведения.ДокументОшибки = РезультатПакета.ДокументОшибки;
		СостояниеПерепроведения.ТекстОшибки = РезультатПакета.ТекстОшибки;
		ЗавершитьПерепроведение(Ложь);
		Возврат;
	КонецЕсли;

	Состояние = "Обработано " + Строка(СостояниеПерепроведения.Индекс)
		+ " из " + Строка(КоличествоДокументовПлана)
		+ ". Успешно: " + Строка(СостояниеПерепроведения.Успешно)
		+ ", пропущено: " + Строка(СостояниеПерепроведения.Пропущено) + ".";

	Если ЗапрошенаОстановка Тогда
		ЗавершитьПерепроведение(Истина);
		Возврат;
	КонецЕсли;

	Если СостояниеПерепроведения.Индекс >= КоличествоДокументовПлана Тогда
		ЗавершитьПерепроведение(Ложь);
		Возврат;
	КонецЕсли;

	ПодключитьОбработчикОжидания("ПродолжитьПослеПаузы", 0.2, Истина);

КонецПроцедуры


&НаКлиенте
Процедура ПродолжитьПослеПаузы() Экспорт
	ОбработатьСледующийПакет();
КонецПроцедуры


&НаКлиенте
Процедура ЗавершитьПерепроведение(ОстановленоПользователем)

	Если СостояниеПерепроведения = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьЗавершениеВЖурналНаСервере(
		СостояниеПерепроведения.Успешно,
		СостояниеПерепроведения.Пропущено,
		СостояниеПерепроведения.Ошибок,
		СостояниеПерепроведения.ДокументОшибки,
		СостояниеПерепроведения.ТекстОшибки,
		ОстановленоПользователем);

	Итог = "Перепроведение завершено."
		+ Символы.ПС + "Успешно: " + Строка(СостояниеПерепроведения.Успешно)
		+ Символы.ПС + "Пропущено: " + Строка(СостояниеПерепроведения.Пропущено)
		+ Символы.ПС + "Ошибок: " + Строка(СостояниеПерепроведения.Ошибок);

	Если ОстановленоПользователем Тогда
		Итог = Итог + Символы.ПС + "Операция остановлена пользователем после завершения пакета.";
	КонецЕсли;

	Если СостояниеПерепроведения.Ошибок > 0 Тогда
		Итог = Итог + Символы.ПС + "Документ ошибки: " + СостояниеПерепроведения.ДокументОшибки
			+ Символы.ПС + "Ошибка: " + СостояниеПерепроведения.ТекстОшибки;
	ИначеЕсли Не ОстановленоПользователем Тогда
		Итог = Итог + Символы.ПС + Символы.ПС
			+ "Следующий обязательный шаг: выполнить типовое закрытие каждого месяца по порядку, начиная с самого раннего измененного месяца.";
	КонецЕсли;

	Протокол = Протокол + Символы.ПС + Символы.ПС + Итог;
	Состояние = Итог;
	СостояниеПерепроведения = Неопределено;
	ЗапрошенаОстановка = Ложь;

	Сообщить(Итог);

КонецПроцедуры

#КонецОбласти

#Область ПроверкиКлиента

&НаКлиенте
Функция ПроверитьПериод()

	Если Не ЗначениеЗаполнено(ДатаНачала) Тогда
		Сообщить("Укажите начало периода.");
		Возврат Ложь;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		Сообщить("Укажите конец периода.");
		Возврат Ложь;
	КонецЕсли;

	Если ДатаНачала > ДатаОкончания Тогда
		Сообщить("Начало периода больше окончания периода.");
		Возврат Ложь;
	КонецЕсли;

	Если КонецДня(ДатаОкончания) > КонецДня(ТекущаяДата()) Тогда
		Сообщить("Конец периода не может быть позже текущей даты.");
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

#КонецОбласти

#Область СерверноеФормированиеПлана

&НаСервере
Функция СформироватьПланНаСервере()

	НачалоПериода = НачалоДня(ДатаНачала);
	КонецПериода = КонецДня(ДатаОкончания);

	ТаблицаПлана = Новый ТаблицаЗначений;
	ТаблицаПлана.Колонки.Добавить("Момент");
	ТаблицаПлана.Колонки.Добавить("Ссылка");
	ТаблицаПлана.Колонки.Добавить("ВидДокумента");
	ТаблицаПлана.Колонки.Добавить("Дата");

	Статистика = Новый Соответствие;
	ОшибкиЧтения = Новый Массив;

	Для Каждого МетаДокумента Из Метаданные.Документы Цикл

		Если Не ПравоДоступа("Чтение", МетаДокумента) Тогда
			ОшибкиЧтения.Добавить(МетаДокумента.Имя + ": недостаточно прав на чтение. Формируйте план под полными правами.");
			Продолжить;
		КонецЕсли;

		ТекстЗапроса =
		"ВЫБРАТЬ
		|    Документы.Ссылка КАК Ссылка,
		|    Документы.Дата КАК Дата
		|ИЗ
		|    Документ.%ИМЯДОКУМЕНТА% КАК Документы
		|ГДЕ
		|    Документы.Проведен = ИСТИНА
		|    И Документы.ПометкаУдаления = ЛОЖЬ
		|    И Документы.Дата >= &НачалоПериода
		|    И Документы.Дата <= &КонецПериода";

		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ИМЯДОКУМЕНТА%", МетаДокумента.Имя);

		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

		Попытка
			Выборка = Запрос.Выполнить().Выбрать();
		Исключение
			ТекстОшибки = МетаДокумента.Имя + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ОшибкиЧтения.Добавить(ТекстОшибки);
			ЗаписатьВЖурнал("ИСС.ВосстановлениеСебестоимости.План.ОшибкаЧтения", УровеньЖурналаРегистрации.Ошибка, МетаДокумента, , ТекстОшибки);
			Продолжить;
		КонецПопытки;

		КоличествоВида = 0;

		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ТаблицаПлана.Добавить();
			НоваяСтрока.Ссылка = Выборка.Ссылка;
			НоваяСтрока.Дата = Выборка.Дата;
			НоваяСтрока.ВидДокумента = МетаДокумента.Имя;
			НоваяСтрока.Момент = Выборка.Ссылка.МоментВремени();
			КоличествоВида = КоличествоВида + 1;
		КонецЦикла;

		Если КоличествоВида > 0 Тогда
			Статистика.Вставить(МетаДокумента.Имя, КоличествоВида);
		КонецЕсли;

	КонецЦикла;

	ТаблицаПлана.Сортировать("Момент Возр");

	МассивДокументов = Новый Массив;
	Для Каждого СтрокаПлана Из ТаблицаПлана Цикл
		ОписаниеДокумента = Новый Структура;
		ОписаниеДокумента.Вставить("Ссылка", СтрокаПлана.Ссылка);
		ОписаниеДокумента.Вставить("ВидДокумента", СтрокаПлана.ВидДокумента);
		ОписаниеДокумента.Вставить("Дата", СтрокаПлана.Дата);
		МассивДокументов.Добавить(ОписаниеДокумента);
	КонецЦикла;

	АдресВременногоХранилища = ПоместитьВоВременноеХранилище(МассивДокументов, УникальныйИдентификатор);

	ПротоколПлана = "ПЛАН ПЕРЕПРОВЕДЕНИЯ 1.0.0"
		+ Символы.ПС + "Период: " + Формат(НачалоПериода, "ДФ=dd.MM.yyyy HH:mm:ss")
		+ " - " + Формат(КонецПериода, "ДФ=dd.MM.yyyy HH:mm:ss")
		+ Символы.ПС + "Всего проведенных документов: " + Строка(МассивДокументов.Количество())
		+ Символы.ПС + "Порядок: МоментВремени, неоперативное проведение, пакет 10 документов."
		+ Символы.ПС + "Данные при формировании плана не изменялись."
		+ Символы.ПС + Символы.ПС + "По видам документов:";

	Для Каждого ЭлементСтатистики Из Статистика Цикл
		ПротоколПлана = ПротоколПлана + Символы.ПС + "- " + ЭлементСтатистики.Ключ + ": " + Строка(ЭлементСтатистики.Значение);
	КонецЦикла;

	Если ОшибкиЧтения.Количество() > 0 Тогда
		ПротоколПлана = ПротоколПлана + Символы.ПС + Символы.ПС
			+ "ОШИБКИ ЧТЕНИЯ — ЗАПУСК ЗАПРЕЩЕН ДО ИСПРАВЛЕНИЯ:";
		Для Каждого ТекстОшибки Из ОшибкиЧтения Цикл
			ПротоколПлана = ПротоколПлана + Символы.ПС + "- " + ТекстОшибки;
		КонецЦикла;
	КонецЕсли;

	ЗаписатьВЖурнал("ИСС.ВосстановлениеСебестоимости.План.Сформирован", УровеньЖурналаРегистрации.Информация, , ,
		"Период: " + Формат(НачалоПериода, "ДФ=dd.MM.yyyy") + " - " + Формат(КонецПериода, "ДФ=dd.MM.yyyy")
		+ ". Документов: " + Строка(МассивДокументов.Количество()) + ". Ошибок чтения: " + Строка(ОшибкиЧтения.Количество()));

	Возврат Новый Структура(
		"АдресПлана,Количество,Начало,Конец,ОшибокЧтения,Протокол",
		АдресВременногоХранилища,
		МассивДокументов.Количество(),
		НачалоПериода,
		КонецПериода,
		ОшибкиЧтения.Количество(),
		ПротоколПлана);

КонецФункции

#КонецОбласти

#Область СерверноеПерепроведение

&НаСервере
Функция ПерепровестиПакетНаСервере(АдресВременногоХранилища, НачальныйИндекс, РазмерПакета)

	План = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
	Если План = Неопределено Тогда
		ВызватьИсключение "План перепроведения отсутствует во временном хранилище. Сформируйте его повторно.";
	КонецЕсли;

	СледующийИндекс = НачальныйИндекс;
	Успешно = 0;
	Пропущено = 0;
	Ошибок = 0;
	ДокументОшибки = "";
	ТекстОшибки = "";
	КонечныйИндекс = Мин(План.Количество(), НачальныйИндекс + РазмерПакета);

	Для Индекс = НачальныйИндекс По КонечныйИндекс - 1 Цикл

		ОписаниеДокумента = План[Индекс];
		СсылкаДокумента = ОписаниеДокумента.Ссылка;

		Попытка
			ОбъектДокумента = СсылкаДокумента.ПолучитьОбъект();

			Если Не ОбъектДокумента.Проведен Тогда
				Пропущено = Пропущено + 1;
				СледующийИндекс = Индекс + 1;
				ЗаписатьВЖурнал("ИСС.ВосстановлениеСебестоимости.Документ.Пропущен", УровеньЖурналаРегистрации.Предупреждение,
					Метаданные.НайтиПоТипу(ТипЗнч(СсылкаДокумента)), СсылкаДокумента, "Документ перестал быть проведенным после формирования плана.");
				Продолжить;
			КонецЕсли;

			ОбъектДокумента.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
			Успешно = Успешно + 1;
			СледующийИндекс = Индекс + 1;

			ЗаписатьВЖурнал("ИСС.ВосстановлениеСебестоимости.Документ.Перепроведен", УровеньЖурналаРегистрации.Информация,
				Метаданные.НайтиПоТипу(ТипЗнч(СсылкаДокумента)), СсылкаДокумента, "Вид документа: " + ОписаниеДокумента.ВидДокумента + ".");

		Исключение
			Ошибок = 1;
			ДокументОшибки = Строка(СсылкаДокумента);
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписатьВЖурнал("ИСС.ВосстановлениеСебестоимости.Документ.Ошибка", УровеньЖурналаРегистрации.Ошибка,
				Метаданные.НайтиПоТипу(ТипЗнч(СсылкаДокумента)), СсылкаДокумента, ТекстОшибки);
			Прервать;
		КонецПопытки;

	КонецЦикла;

	Возврат Новый Структура("СледующийИндекс,Успешно,Пропущено,Ошибок,ДокументОшибки,ТекстОшибки",
		СледующийИндекс, Успешно, Пропущено, Ошибок, ДокументОшибки, ТекстОшибки);

КонецФункции

#КонецОбласти

#Область БыстрыйКонтроль

&НаСервере
Функция ВыполнитьБыстрыйКонтрольНаСервере()

	МетаРегистра = Метаданные.РегистрыНакопления.Найти("Запасы");
	Если МетаРегистра = Неопределено Тогда
		Возврат "БЫСТРЫЙ КОНТРОЛЬ: регистр накопления Запасы не найден. Используйте типовые отчеты УНФ.";
	КонецЕсли;

	Если МетаРегистра.Измерения.Найти("Номенклатура") = Неопределено
		Или МетаРегистра.Ресурсы.Найти("Количество") = Неопределено
		Или МетаРегистра.Ресурсы.Найти("Сумма") = Неопределено Тогда
		Возврат "БЫСТРЫЙ КОНТРОЛЬ: структура регистра Запасы отличается от ожидаемой. Используйте типовые отчеты УНФ.";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|    Остатки.Номенклатура КАК Номенклатура,
	|    СУММА(Остатки.КоличествоОстаток) КАК Количество,
	|    СУММА(Остатки.СуммаОстаток) КАК Сумма
	|ИЗ
	|    РегистрНакопления.Запасы.Остатки(&ГраницаПериода) КАК Остатки
	|СГРУППИРОВАТЬ ПО
	|    Остатки.Номенклатура";
	Запрос.УстановитьПараметр("ГраницаПериода", КонецДня(ДатаОкончания));

	Выборка = Запрос.Выполнить().Выбрать();
	ТочностьКоличество = 0.000001;
	ТочностьСуммы = 0.01;
	КоличествоПроблем = 0;
	Примеры = "";

	Пока Выборка.Следующий() Цикл
		Причина = "";
		Если Выборка.Количество < -ТочностьКоличество Тогда
			Причина = "отрицательное количество";
		ИначеЕсли Выборка.Количество > ТочностьКоличество И Выборка.Сумма < -ТочностьСуммы Тогда
			Причина = "отрицательная стоимость";
		ИначеЕсли Выборка.Количество > ТочностьКоличество И Абс(Выборка.Сумма) <= ТочностьСуммы Тогда
			Причина = "количество без стоимости";
		ИначеЕсли Абс(Выборка.Количество) <= ТочностьКоличество И Абс(Выборка.Сумма) > ТочностьСуммы Тогда
			Причина = "стоимость без количества";
		КонецЕсли;

		Если Причина <> "" Тогда
			КоличествоПроблем = КоличествоПроблем + 1;
			Если КоличествоПроблем <= 20 Тогда
				Примеры = Примеры + Символы.ПС + "- " + Строка(Выборка.Номенклатура)
					+ ": " + Причина + ", количество " + Строка(Выборка.Количество) + ", сумма " + Строка(Выборка.Сумма);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Результат = "БЫСТРЫЙ КОНТРОЛЬ НА " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy")
		+ Символы.ПС + "Проблемных позиций по сводному остатку: " + Строка(КоличествоПроблем);

	Если КоличествоПроблем > 0 Тогда
		Результат = Результат + Символы.ПС + "Первые 20:" + Примеры;
	КонецЕсли;

	Результат = Результат + Символы.ПС
		+ "Важно: это экспресс-контроль. Окончательная проверка выполняется типовыми отчетами УНФ после закрытия месяца.";

	ЗаписатьВЖурнал("ИСС.ВосстановлениеСебестоимости.Контроль", УровеньЖурналаРегистрации.Информация, , ,
		"Период до " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy") + ". Проблемных позиций: " + Строка(КоличествоПроблем));

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ЖурналРегистрации

&НаСервере
Процедура ЗаписатьНачалоВЖурналНаСервере(НачалоПериода, КонецПериода, КоличествоДокументов)
	ЗаписатьВЖурнал("ИСС.ВосстановлениеСебестоимости.Начало", УровеньЖурналаРегистрации.Информация, , ,
		"Версия 1.0.0. Период: " + Формат(НачалоПериода, "ДФ=dd.MM.yyyy HH:mm:ss")
		+ " - " + Формат(КонецПериода, "ДФ=dd.MM.yyyy HH:mm:ss")
		+ ". Документов: " + Строка(КоличествоДокументов) + ".");
КонецПроцедуры


&НаСервере
Процедура ЗаписатьЗавершениеВЖурналНаСервере(Успешно, Пропущено, Ошибок, ДокументОшибки, ТекстОшибки, Остановлено)

	Уровень = ?(Ошибок > 0, УровеньЖурналаРегистрации.Ошибка, УровеньЖурналаРегистрации.Информация);
	Комментарий = "Версия 1.0.0. Успешно: " + Строка(Успешно)
		+ ". Пропущено: " + Строка(Пропущено)
		+ ". Ошибок: " + Строка(Ошибок)
		+ ". Остановлено пользователем: " + Строка(Остановлено) + ".";

	Если Ошибок > 0 Тогда
		Комментарий = Комментарий + " Документ: " + ДокументОшибки + ". Ошибка: " + ТекстОшибки;
	КонецЕсли;

	ЗаписатьВЖурнал("ИСС.ВосстановлениеСебестоимости.Завершено", Уровень, , , Комментарий);

КонецПроцедуры


&НаСервере
Процедура ЗаписатьВЖурнал(ИмяСобытия, Уровень, ОбъектМетаданных = Неопределено, Данные = Неопределено, Комментарий = "")
	Попытка
		ЗаписьЖурналаРегистрации(ИмяСобытия, Уровень, ОбъектМетаданных, Данные, Лев(Комментарий, 5000));
	Исключение
		// Ошибка журнала не должна останавливать учетную операцию.
	КонецПопытки;
КонецПроцедуры

#КонецОбласти
